{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/kimgea/agent-kit/schemas/verification-harness-audit/v1.json",
  "title": "Verification harness audit result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "context_sha256",
    "status",
    "target",
    "inventory",
    "context_inventory",
    "guidance",
    "execution",
    "evidence_sources",
    "summary",
    "coverage",
    "recommendations",
    "limitations"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "context_sha256": {"$ref": "#/$defs/sha256"},
    "status": {"enum": ["PASS", "IMPROVEMENTS", "INCOMPLETE"]},
    "target": {"$ref": "#/$defs/target"},
    "inventory": {"$ref": "#/$defs/inventory"},
    "context_inventory": {
      "type": "array",
      "maxItems": 5000,
      "items": {"$ref": "#/$defs/inventory_file"}
    },
    "guidance": {
      "type": "array",
      "maxItems": 21000,
      "items": {"$ref": "#/$defs/guidance_chain"}
    },
    "execution": {
      "type": "array",
      "maxItems": 256,
      "items": {"$ref": "#/$defs/command_record"}
    },
    "evidence_sources": {
      "type": "array",
      "maxItems": 256,
      "items": {"$ref": "#/$defs/evidence_source"}
    },
    "summary": {"$ref": "#/$defs/summary"},
    "coverage": {"$ref": "#/$defs/coverage"},
    "recommendations": {
      "type": "array",
      "maxItems": 2000,
      "items": {"$ref": "#/$defs/recommendation"}
    },
    "limitations": {
      "type": "array",
      "maxItems": 2000,
      "items": {"$ref": "#/$defs/limitation"}
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "repository_path": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096,
      "pattern": "^(?!/)(?![A-Za-z]:)(?!.*\\\\)(?!.*//)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*[\\u0000-\\u001f\\u007f])(?!.*/$).+$"
    },
    "nullable_line": {
      "type": ["integer", "null"],
      "minimum": 1,
      "maximum": 100000000
    },
    "location": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "start_line", "end_line"],
      "properties": {
        "path": {
          "anyOf": [
            {"const": "."},
            {"$ref": "#/$defs/repository_path"}
          ]
        },
        "start_line": {"$ref": "#/$defs/nullable_line"},
        "end_line": {"$ref": "#/$defs/nullable_line"}
      }
    },
    "focus": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "value"],
      "properties": {
        "kind": {
          "enum": [
            "line_range",
            "symbol",
            "test_case",
            "ci_job",
            "configuration_section",
            "command",
            "other"
          ]
        },
        "value": {"type": "string", "minLength": 1, "maxLength": 2000}
      }
    },
    "requested_target": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "target_id",
        "kind",
        "path",
        "start_line",
        "end_line",
        "focus"
      ],
      "properties": {
        "target_id": {"type": "string", "pattern": "^T[0-9]{3,6}$"},
        "kind": {"enum": ["part", "file", "directory", "project"]},
        "path": {
          "anyOf": [
            {"const": "."},
            {"$ref": "#/$defs/repository_path"}
          ]
        },
        "start_line": {"$ref": "#/$defs/nullable_line"},
        "end_line": {"$ref": "#/$defs/nullable_line"},
        "focus": {
          "anyOf": [
            {"$ref": "#/$defs/focus"},
            {"type": "null"}
          ]
        }
      }
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "repository_root", "requested"],
      "properties": {
        "kind": {"const": "current_filesystem"},
        "repository_root": {"type": "string", "minLength": 1, "maxLength": 8192},
        "requested": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1000,
          "items": {"$ref": "#/$defs/requested_target"}
        }
      }
    },
    "inventory_limits": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "maximum_files",
        "maximum_file_bytes",
        "maximum_total_bytes",
        "maximum_traversal_entries",
        "maximum_context_files",
        "maximum_context_bytes"
      ],
      "properties": {
        "maximum_files": {"type": "integer", "minimum": 1, "maximum": 20000},
        "maximum_file_bytes": {"type": "integer", "minimum": 1, "maximum": 16777216},
        "maximum_total_bytes": {"type": "integer", "minimum": 1, "maximum": 268435456},
        "maximum_traversal_entries": {"type": "integer", "minimum": 1, "maximum": 1000000},
        "maximum_context_files": {"type": "integer", "minimum": 0, "maximum": 5000},
        "maximum_context_bytes": {"type": "integer", "minimum": 0, "maximum": 67108864}
      }
    },
    "inventory_file": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "bytes",
        "sha256",
        "inspection_kind",
        "tracking"
      ],
      "properties": {
        "path": {"$ref": "#/$defs/repository_path"},
        "bytes": {"type": "integer", "minimum": 0, "maximum": 9223372036854775807},
        "sha256": {
          "anyOf": [
            {"$ref": "#/$defs/sha256"},
            {"type": "null"}
          ]
        },
        "inspection_kind": {
          "enum": ["text", "binary", "non_utf8", "oversized", "unreadable", "not_inspected"]
        },
        "tracking": {"enum": ["tracked", "untracked", "ignored", "unknown"]}
      }
    },
    "inventory": {
      "type": "object",
      "additionalProperties": false,
      "required": ["limits", "traversed_entries", "read_bytes", "context_read_bytes", "files", "complete"],
      "properties": {
        "limits": {"$ref": "#/$defs/inventory_limits"},
        "traversed_entries": {"type": "integer", "minimum": 0, "maximum": 1000000},
        "read_bytes": {"type": "integer", "minimum": 0, "maximum": 268435456},
        "context_read_bytes": {"type": "integer", "minimum": 0, "maximum": 67108864},
        "files": {
          "type": "array",
          "maxItems": 20000,
          "items": {"$ref": "#/$defs/inventory_file"}
        },
        "complete": {"type": "boolean"}
      }
    },
    "guidance_source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_kind",
        "path",
        "revision",
        "sha256",
        "bytes",
        "lines",
        "loaded"
      ],
      "properties": {
        "source_kind": {"enum": ["skill", "user_global", "repository"]},
        "path": {"type": "string", "minLength": 1, "maxLength": 8192},
        "revision": {"type": ["string", "null"], "maxLength": 256},
        "sha256": {"$ref": "#/$defs/sha256"},
        "bytes": {"type": "integer", "minimum": 0, "maximum": 16777216},
        "lines": {"type": "integer", "minimum": 0, "maximum": 1048576},
        "loaded": {"type": "boolean"}
      }
    },
    "guidance_chain": {
      "type": "object",
      "additionalProperties": false,
      "required": ["chain_id", "target_ids", "paths", "sources", "complete"],
      "properties": {
        "chain_id": {"type": "string", "pattern": "^G[0-9]{3,6}$"},
        "target_ids": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1000,
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^T[0-9]{3,6}$"}
        },
        "paths": {
          "type": "array",
          "minItems": 1,
          "maxItems": 21000,
          "uniqueItems": true,
          "items": {
            "anyOf": [
              {"const": "."},
              {"$ref": "#/$defs/repository_path"}
            ]
          }
        },
        "sources": {
          "type": "array",
          "maxItems": 256,
          "items": {"$ref": "#/$defs/guidance_source"}
        },
        "complete": {"type": "boolean"}
      }
    },
    "authorization": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "source", "source_sha256"],
      "properties": {
        "kind": {"enum": ["not_requested", "denied", "caller", "user_global"]},
        "source": {"type": ["string", "null"], "maxLength": 2000},
        "source_sha256": {
          "anyOf": [
            {"$ref": "#/$defs/sha256"},
            {"type": "null"}
          ]
        }
      }
    },
    "command_record": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "command_id",
        "argv",
        "cwd",
        "reason",
        "expected_effects",
        "timeout_seconds",
        "repetitions",
        "authorization",
        "outcome",
        "exit_code",
        "duration_ms",
        "output_sha256",
        "summary"
      ],
      "properties": {
        "command_id": {"type": "string", "pattern": "^C[0-9]{3,6}$"},
        "argv": {
          "type": "array",
          "minItems": 1,
          "maxItems": 128,
          "items": {"type": "string", "minLength": 1, "maxLength": 4096}
        },
        "cwd": {
          "anyOf": [
            {"const": "."},
            {"$ref": "#/$defs/repository_path"}
          ]
        },
        "reason": {"type": "string", "minLength": 1, "maxLength": 4000},
        "expected_effects": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "items": {"type": "string", "minLength": 1, "maxLength": 2000}
        },
        "timeout_seconds": {"type": "integer", "minimum": 1, "maximum": 86400},
        "repetitions": {"type": "integer", "minimum": 1, "maximum": 100},
        "authorization": {"$ref": "#/$defs/authorization"},
        "outcome": {"enum": ["not_run", "passed", "failed", "timed_out", "refused"]},
        "exit_code": {"type": ["integer", "null"], "minimum": -2147483648, "maximum": 2147483647},
        "duration_ms": {"type": ["integer", "null"], "minimum": 0, "maximum": 8640000000},
        "output_sha256": {
          "anyOf": [
            {"$ref": "#/$defs/sha256"},
            {"type": "null"}
          ]
        },
        "summary": {"type": "string", "minLength": 1, "maxLength": 4000}
      }
    },
    "evidence_source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "evidence_source_id",
        "kind",
        "source_label",
        "source_sha256",
        "observed_at",
        "supplied_at",
        "freshness",
        "freshness_basis"
      ],
      "properties": {
        "evidence_source_id": {"type": "string", "pattern": "^S[0-9]{3,6}$"},
        "kind": {"enum": ["timing", "failure", "history", "other"]},
        "source_label": {"type": "string", "minLength": 1, "maxLength": 1000},
        "source_sha256": {"$ref": "#/$defs/sha256"},
        "observed_at": {
          "anyOf": [
            {"type": "string", "format": "date-time", "maxLength": 64},
            {"type": "null"}
          ]
        },
        "supplied_at": {"type": "string", "format": "date-time", "maxLength": 64},
        "freshness": {"enum": ["fresh", "stale", "unknown"]},
        "freshness_basis": {"type": "string", "minLength": 1, "maxLength": 2000}
      }
    },
    "strength_counts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["essential", "strong", "moderate", "optional"],
      "properties": {
        "essential": {"type": "integer", "minimum": 0, "maximum": 2000},
        "strong": {"type": "integer", "minimum": 0, "maximum": 2000},
        "moderate": {"type": "integer", "minimum": 0, "maximum": 2000},
        "optional": {"type": "integer", "minimum": 0, "maximum": 2000}
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "conclusion",
        "recommendation_counts",
        "ready",
        "decision_required",
        "observed_defects",
        "inferred_risks"
      ],
      "properties": {
        "conclusion": {"type": "string", "minLength": 1, "maxLength": 4000},
        "recommendation_counts": {"$ref": "#/$defs/strength_counts"},
        "ready": {"type": "integer", "minimum": 0, "maximum": 2000},
        "decision_required": {"type": "integer", "minimum": 0, "maximum": 2000},
        "observed_defects": {"type": "integer", "minimum": 0, "maximum": 2000},
        "inferred_risks": {"type": "integer", "minimum": 0, "maximum": 2000}
      }
    },
    "excluded": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "reason", "material"],
      "properties": {
        "path": {"$ref": "#/$defs/repository_path"},
        "reason": {"type": "string", "minLength": 1, "maxLength": 2000},
        "material": {"type": "boolean"}
      }
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "complete",
        "inspected_targets",
        "inspected_harness_paths",
        "classified_non_harness_paths",
        "excluded",
        "context_paths"
      ],
      "properties": {
        "complete": {"type": "boolean"},
        "inspected_targets": {
          "type": "array",
          "maxItems": 1000,
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^T[0-9]{3,6}$"}
        },
        "inspected_harness_paths": {
          "type": "array",
          "maxItems": 20000,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/repository_path"}
        },
        "classified_non_harness_paths": {
          "type": "array",
          "maxItems": 20000,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/repository_path"}
        },
        "excluded": {
          "type": "array",
          "maxItems": 20000,
          "items": {"$ref": "#/$defs/excluded"}
        },
        "context_paths": {
          "type": "array",
          "maxItems": 5000,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/repository_path"}
        }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "description", "location", "source_id"],
      "allOf": [
        {
          "if": {"properties": {"kind": {"const": "command"}}},
          "then": {"properties": {"source_id": {"type": "string", "pattern": "^C[0-9]{3,6}$"}}}
        },
        {
          "if": {"properties": {"kind": {"enum": ["history", "caller_supplied"]}}},
          "then": {"properties": {"source_id": {"type": "string", "pattern": "^S[0-9]{3,6}$"}}}
        }
      ],
      "properties": {
        "kind": {
          "enum": [
            "harness",
            "test",
            "code",
            "specification",
            "documentation",
            "configuration",
            "guidance",
            "command",
            "history",
            "caller_supplied",
            "reasoning"
          ]
        },
        "description": {"type": "string", "minLength": 1, "maxLength": 4000},
        "location": {
          "anyOf": [
            {"$ref": "#/$defs/location"},
            {"type": "null"}
          ]
        },
        "source_id": {
          "anyOf": [
            {"type": "string", "pattern": "^[SC][0-9]{3,6}$"},
            {"type": "null"}
          ]
        }
      }
    },
    "safe_direction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["outcome", "acceptance_evidence", "alternatives", "suggested_paths"],
      "properties": {
        "outcome": {"type": "string", "minLength": 1, "maxLength": 4000},
        "acceptance_evidence": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "items": {"type": "string", "minLength": 1, "maxLength": 2000}
        },
        "alternatives": {
          "type": "array",
          "maxItems": 16,
          "items": {"type": "string", "minLength": 1, "maxLength": 2000}
        },
        "suggested_paths": {
          "type": "array",
          "maxItems": 64,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/repository_path"}
        }
      }
    },
    "recommendation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "recommendation_id",
        "fingerprint",
        "kind",
        "action",
        "strength",
        "impact",
        "confidence",
        "decision",
        "decision_reason",
        "claim",
        "basis",
        "basis_reference",
        "title",
        "problem",
        "reason",
        "impact_summary",
        "affected_targets",
        "affected_locations",
        "related_context",
        "evidence",
        "current_tier",
        "recommended_tier",
        "safe_direction"
      ],
      "properties": {
        "recommendation_id": {"type": "string", "pattern": "^R[0-9]{3,6}$"},
        "fingerprint": {"$ref": "#/$defs/sha256"},
        "kind": {
          "enum": [
            "missing_coverage",
            "weak_assertion",
            "disconnected_check",
            "late_feedback",
            "slow_feedback",
            "flakiness",
            "nondeterminism",
            "unsafe_mutation",
            "isolation",
            "redundancy",
            "platform_gap",
            "failure_visibility",
            "discoverability",
            "local_ci_drift",
            "maintenance",
            "other"
          ]
        },
        "action": {
          "enum": [
            "add",
            "strengthen",
            "wire",
            "move_tier",
            "stabilize",
            "isolate",
            "deduplicate",
            "remove",
            "document",
            "other"
          ]
        },
        "strength": {"enum": ["essential", "strong", "moderate", "optional"]},
        "impact": {"enum": ["critical", "high", "medium", "low"]},
        "confidence": {"enum": ["high", "medium", "low"]},
        "decision": {"enum": ["ready", "decision_required"]},
        "decision_reason": {"type": "string", "minLength": 1, "maxLength": 3000},
        "claim": {"enum": ["observed_defect", "inferred_risk", "improvement_opportunity"]},
        "basis": {
          "enum": [
            "specification",
            "supported_behavior",
            "public_contract",
            "compatibility_promise",
            "safety_boundary",
            "required_workflow",
            "new_policy",
            "uncertain"
          ]
        },
        "basis_reference": {"type": "string", "minLength": 1, "maxLength": 4000},
        "title": {"type": "string", "minLength": 1, "maxLength": 300},
        "problem": {"type": "string", "minLength": 1, "maxLength": 6000},
        "reason": {"type": "string", "minLength": 1, "maxLength": 6000},
        "impact_summary": {"type": "string", "minLength": 1, "maxLength": 4000},
        "affected_targets": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1000,
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^T[0-9]{3,6}$"}
        },
        "affected_locations": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "items": {"$ref": "#/$defs/location"}
        },
        "related_context": {
          "type": "array",
          "maxItems": 64,
          "items": {"$ref": "#/$defs/location"}
        },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "items": {"$ref": "#/$defs/evidence"}
        },
        "current_tier": {"enum": ["routine", "pre_merge", "integration", "release", "manual", "unknown", "absent"]},
        "recommended_tier": {"enum": ["routine", "pre_merge", "integration", "release", "manual", "none", "unknown"]},
        "safe_direction": {"$ref": "#/$defs/safe_direction"}
      }
    },
    "limitation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "message", "affected_paths", "material"],
      "properties": {
        "code": {
          "enum": [
            "scope_truncated",
            "ignored_path",
            "link_skipped",
            "target_unreadable",
            "part_unreadable",
            "inventory_incomplete",
            "guidance_unreadable",
            "guidance_budget",
            "context_unavailable",
            "evidence_missing",
            "conflicting_evidence",
            "verification_not_authorized",
            "verification_unavailable",
            "verification_failed",
            "delegation_unavailable",
            "budget_exhausted",
            "other"
          ]
        },
        "message": {"type": "string", "minLength": 1, "maxLength": 4000},
        "affected_paths": {
          "type": "array",
          "maxItems": 20000,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/repository_path"}
        },
        "material": {"type": "boolean"}
      }
    }
  }
}
