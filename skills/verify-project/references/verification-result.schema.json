{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/kimgea/agent-kit/schemas/verify-project/verification-result-1.0.0.json",
  "title": "Verify Project canonical verification result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "context_sha256",
    "plan_sha256",
    "target",
    "target_sha256",
    "targets",
    "repository_state",
    "policy",
    "guidance",
    "guidance_interpretations",
    "discovery",
    "verifier",
    "completion",
    "outcome",
    "next_action",
    "summary",
    "claims",
    "checks",
    "plan_adherence",
    "coverage",
    "mutation",
    "observations",
    "limitations"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "context_sha256": {"$ref": "#/$defs/sha256"},
    "plan_sha256": {"$ref": "#/$defs/sha256"},
    "target": {"$ref": "#/$defs/target"},
    "target_sha256": {"$ref": "#/$defs/sha256"},
    "targets": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20000,
      "items": {"$ref": "#/$defs/target_record"}
    },
    "repository_state": {"$ref": "#/$defs/repository_state"},
    "policy": {"type": "array", "minItems": 1, "maxItems": 64, "items": {"$ref": "#/$defs/policy_source"}},
    "guidance": {"$ref": "#/$defs/guidance_provenance"},
    "guidance_interpretations": {
      "type": "array",
      "maxItems": 5000,
      "items": {"$ref": "#/$defs/guidance_interpretation"}
    },
    "discovery": {"type": "array", "maxItems": 5000, "items": {"$ref": "#/$defs/discovery_source"}},
    "verifier": {"$ref": "#/$defs/verifier"},
    "completion": {"enum": ["complete", "incomplete"]},
    "outcome": {"enum": ["pass", "fail", "unknown"]},
    "next_action": {"enum": ["none", "triage", "plan", "decision", "authorization", "retry", "rescope", "manual"]},
    "summary": {"$ref": "#/$defs/summary"},
    "claims": {
      "type": "array",
      "maxItems": 20000,
      "items": {"$ref": "#/$defs/claim_result"}
    },
    "checks": {
      "type": "array",
      "maxItems": 128,
      "items": {"$ref": "#/$defs/check_result"}
    },
    "plan_adherence": {"$ref": "#/$defs/plan_adherence"},
    "coverage": {"$ref": "#/$defs/result_coverage"},
    "mutation": {"$ref": "#/$defs/mutation"},
    "observations": {
      "type": "array",
      "maxItems": 1000,
      "items": {"$ref": "#/$defs/observation"}
    },
    "limitations": {
      "type": "array",
      "maxItems": 256,
      "items": {"$ref": "#/$defs/limitation"}
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "repository_path": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096,
      "pattern": "^(?!/)(?![A-Za-z]:)(?!.*\\\\)(?!.*[\\u0000-\\u001F\\u007F])(?!.*//)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*/$).+$"
    },
    "path_or_root": {
      "anyOf": [
        {"const": "."},
        {"$ref": "#/$defs/repository_path"}
      ]
    },
    "nullable_revision": {"type": ["string", "null"], "minLength": 1, "maxLength": 512},
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "repository_root", "base_revision", "requested_paths"],
      "properties": {
        "kind": {"enum": ["working_tree", "paths"]},
        "repository_root": {"type": "string", "minLength": 1, "maxLength": 4096},
        "base_revision": {"$ref": "#/$defs/nullable_revision"},
        "requested_paths": {"type": "array", "minItems": 1, "maxItems": 20000, "uniqueItems": true, "items": {"$ref": "#/$defs/path_or_root"}}
      }
    },
    "target_record": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "target_id", "path", "old_path", "change_kind", "presence", "file_kind",
        "inspection_kind", "size_bytes", "mode", "sha256", "guidance_chain_id", "old_guidance_chain_id"
      ],
      "properties": {
        "target_id": {"type": "string", "pattern": "^T[0-9]{3,6}$"},
        "path": {"$ref": "#/$defs/path_or_root"},
        "old_path": {"anyOf": [{"$ref": "#/$defs/repository_path"}, {"type": "null"}]},
        "change_kind": {"enum": ["added", "modified", "deleted", "renamed", "type_changed", "mode_changed", "untracked", "snapshot", "unknown"]},
        "presence": {"enum": ["present", "absent"]},
        "file_kind": {"enum": ["regular", "directory", "absent", "other"]},
        "inspection_kind": {"enum": ["text", "binary", "metadata_only", "absent", "unreadable", "oversized", "unsupported"]},
        "size_bytes": {"type": ["integer", "null"], "minimum": 0, "maximum": 268435456},
        "mode": {"type": ["integer", "null"], "minimum": 0, "maximum": 65535},
        "sha256": {"anyOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]},
        "guidance_chain_id": {"type": "string", "pattern": "^G[0-9]{3,6}$"},
        "old_guidance_chain_id": {"type": ["string", "null"], "pattern": "^G[0-9]{3,6}$"}
      }
    },
    "repository_state": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository_identity_sha256", "git_repository", "head_revision", "protected_state_sha256", "protected_path_hashes"],
      "properties": {
        "repository_identity_sha256": {"$ref": "#/$defs/sha256"},
        "git_repository": {"type": "boolean"},
        "head_revision": {"$ref": "#/$defs/nullable_revision"},
        "protected_state_sha256": {"$ref": "#/$defs/sha256"},
        "protected_path_hashes": {"type": "array", "maxItems": 100000, "uniqueItems": true, "items": {"$ref": "#/$defs/sha256"}}
      }
    },
    "policy_source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["policy_id", "kind", "label", "sha256"],
      "properties": {
        "policy_id": {"type": "string", "pattern": "^P[0-9]{3,6}$"},
        "kind": {"enum": ["caller", "user_global", "project"]},
        "label": {"type": "string", "minLength": 1, "maxLength": 512},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "discovery_source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["discovery_id", "kind", "path", "sha256", "inspection_kind", "provenance"],
      "properties": {
        "discovery_id": {"type": "string", "pattern": "^D[0-9]{3,6}$"},
        "kind": {"enum": ["manifest", "script", "test_configuration", "build_configuration", "lint_configuration", "type_configuration", "local_ci", "related_test", "documentation", "contract", "source", "other"]},
        "path": {"$ref": "#/$defs/repository_path"},
        "sha256": {"anyOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]},
        "inspection_kind": {"enum": ["text", "binary", "metadata_only", "unreadable", "oversized", "unsupported"]},
        "provenance": {"enum": ["caller", "agent_policy", "verify_guidance", "project_entry_point", "related_context"]}
      }
    },
    "guidance_source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_id", "kind", "path", "provenance", "revision", "sha256"],
      "properties": {
        "source_id": {"type": "string", "pattern": "^S[0-9]{3,6}$"},
        "kind": {"enum": ["skill", "repository"]},
        "path": {"$ref": "#/$defs/repository_path"},
        "provenance": {"enum": ["locked_skill", "git_head", "current_filesystem"]},
        "revision": {"$ref": "#/$defs/nullable_revision"},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "guidance_chain": {
      "type": "object",
      "additionalProperties": false,
      "required": ["chain_id", "target_ids", "source_ids", "complete"],
      "properties": {
        "chain_id": {"type": "string", "pattern": "^G[0-9]{3,6}$"},
        "target_ids": {"type": "array", "minItems": 1, "maxItems": 20000, "uniqueItems": true, "items": {"type": "string", "pattern": "^T[0-9]{3,6}$"}},
        "source_ids": {"type": "array", "minItems": 1, "maxItems": 256, "uniqueItems": true, "items": {"type": "string", "pattern": "^S[0-9]{3,6}$"}},
        "complete": {"type": "boolean"}
      }
    },
    "guidance_provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sources", "chains"],
      "properties": {
        "sources": {"type": "array", "minItems": 1, "maxItems": 5000, "items": {"$ref": "#/$defs/guidance_source"}},
        "chains": {"type": "array", "minItems": 1, "maxItems": 20000, "items": {"$ref": "#/$defs/guidance_chain"}}
      }
    },
    "verifier": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "context_kind", "consumer", "target_matched", "context_unchanged", "plan_unchanged"],
      "properties": {
        "name": {"type": "string", "minLength": 1, "maxLength": 128},
        "version": {"type": ["string", "null"], "minLength": 1, "maxLength": 128},
        "context_kind": {"enum": ["fresh", "existing"]},
        "consumer": {"type": ["string", "null"], "minLength": 1, "maxLength": 128},
        "target_matched": {"type": "boolean"},
        "context_unchanged": {"type": "boolean"},
        "plan_unchanged": {"type": "boolean"}
      }
    },
    "location": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "start_line", "end_line"],
      "properties": {
        "path": {"$ref": "#/$defs/path_or_root"},
        "start_line": {"type": ["integer", "null"], "minimum": 1},
        "end_line": {"type": ["integer", "null"], "minimum": 1}
      }
    },
    "evidence_reference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "description", "source_id", "check_id", "attempt_id", "location"],
      "properties": {
        "kind": {"enum": ["target", "policy", "guidance", "discovery", "attempt", "reasoning"]},
        "description": {"type": "string", "minLength": 1, "maxLength": 4000},
        "source_id": {"type": ["string", "null"], "pattern": "^[TSDP][0-9]{3,6}$"},
        "check_id": {"type": ["string", "null"], "pattern": "^K[0-9]{3,6}$"},
        "attempt_id": {"type": ["string", "null"], "pattern": "^A[0-9]{3,6}$"},
        "location": {
          "anyOf": [
            {"$ref": "#/$defs/location"},
            {"type": "null"}
          ]
        }
      }
    },
    "claim_result": {
      "type": "object",
      "additionalProperties": false,
      "required": ["claim_id", "fingerprint", "material", "outcome", "evidence", "reason"],
      "properties": {
        "claim_id": {"type": "string", "pattern": "^C[0-9]{3,6}$"},
        "fingerprint": {"$ref": "#/$defs/sha256"},
        "material": {"type": "boolean"},
        "outcome": {"enum": ["supported", "disproved", "unresolved"]},
        "evidence": {"type": "array", "maxItems": 64, "items": {"$ref": "#/$defs/evidence_reference"}},
        "reason": {"type": "string", "minLength": 1, "maxLength": 4000}
      }
    },
    "guidance_interpretation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["interpretation_id", "source_id", "target_ids", "claim_ids", "kind", "requirement", "replaces_interpretation_id", "replacement_reason"],
      "properties": {
        "interpretation_id": {"type": "string", "pattern": "^I[0-9]{3,6}$"},
        "source_id": {"type": "string", "pattern": "^S[0-9]{3,6}$"},
        "target_ids": {"type": "array", "minItems": 1, "maxItems": 20000, "uniqueItems": true, "items": {"type": "string", "pattern": "^T[0-9]{3,6}$"}},
        "claim_ids": {"type": "array", "maxItems": 20000, "uniqueItems": true, "items": {"type": "string", "pattern": "^C[0-9]{3,6}$"}},
        "kind": {"enum": ["required", "conditional", "recommended", "replacement", "artifact"]},
        "requirement": {"type": "string", "minLength": 1, "maxLength": 4000},
        "replaces_interpretation_id": {"type": ["string", "null"], "pattern": "^I[0-9]{3,6}$"},
        "replacement_reason": {"type": ["string", "null"], "minLength": 1, "maxLength": 4000}
      }
    },
    "stream_evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["byte_count", "captured_byte_count", "sha256", "truncated", "excerpt", "excerpt_redacted"],
      "properties": {
        "byte_count": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
        "captured_byte_count": {"type": "integer", "minimum": 0, "maximum": 16777216},
        "sha256": {"$ref": "#/$defs/sha256"},
        "truncated": {"type": "boolean"},
        "excerpt": {"type": ["string", "null"], "maxLength": 16384},
        "excerpt_redacted": {"type": "boolean"}
      }
    },
    "effect_class": {
      "enum": [
        "repository_read", "local_process", "disposable_repository_write", "bounded_temporary_write",
        "source_mutation", "configuration_mutation", "dependency_installation", "network_access",
        "external_service", "persistent_process", "destructive_action", "permission_change",
        "remote_mutation", "outside_bounded_roots"
      ]
    },
    "artifact_boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["root_kind", "path"],
      "properties": {
        "root_kind": {"enum": ["repository", "run_temp"]},
        "path": {"$ref": "#/$defs/repository_path"}
      }
    },
    "candidate_authority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_kind", "source", "authorized"],
      "properties": {
        "source_kind": {"enum": ["caller", "user_global", "none"]},
        "source": {"type": "string", "minLength": 1, "maxLength": 4000},
        "authorized": {"type": "boolean"}
      }
    },
    "observed_effect": {
      "type": "object",
      "additionalProperties": false,
      "required": ["effect", "root_kind", "path", "before_sha256", "after_sha256", "classification"],
      "properties": {
        "effect": {"$ref": "#/$defs/effect_class"},
        "root_kind": {"enum": ["repository", "run_temp", "outside"]},
        "path": {"$ref": "#/$defs/repository_path"},
        "before_sha256": {
          "anyOf": [
            {"$ref": "#/$defs/sha256"},
            {"type": "null"}
          ]
        },
        "after_sha256": {
          "anyOf": [
            {"$ref": "#/$defs/sha256"},
            {"type": "null"}
          ]
        },
        "classification": {"enum": ["allowed", "unexpected"]}
      }
    },
    "attempt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "attempt_id", "repetition", "status", "exit_code", "duration_ms", "cwd", "argv_sha256",
        "target_before_sha256", "target_after_sha256", "protected_before_sha256", "protected_after_sha256",
        "protected_before_excluded_paths", "protected_after_excluded_paths",
        "run_temp_before_sha256", "run_temp_after_sha256", "run_temp_before_path_hashes",
        "run_temp_after_path_hashes", "run_temp_before_excluded_paths", "run_temp_after_excluded_paths",
        "stdout", "stderr", "observed_effects"
      ],
      "properties": {
        "attempt_id": {"type": "string", "pattern": "^A[0-9]{3,6}$"},
        "repetition": {"type": "integer", "minimum": 1, "maximum": 32},
        "status": {"enum": ["passed", "failed", "timed_out", "unavailable", "skipped"]},
        "exit_code": {"type": ["integer", "null"], "minimum": -2147483648, "maximum": 2147483647},
        "duration_ms": {"type": ["integer", "null"], "minimum": 0, "maximum": 86400000},
        "cwd": {"$ref": "#/$defs/path_or_root"},
        "argv_sha256": {"$ref": "#/$defs/sha256"},
        "target_before_sha256": {"$ref": "#/$defs/sha256"},
        "target_after_sha256": {"$ref": "#/$defs/sha256"},
        "protected_before_sha256": {"$ref": "#/$defs/sha256"},
        "protected_after_sha256": {"$ref": "#/$defs/sha256"},
        "protected_before_excluded_paths": {"type": "array", "maxItems": 5000, "uniqueItems": true, "items": {"$ref": "#/$defs/repository_path"}},
        "protected_after_excluded_paths": {"type": "array", "maxItems": 5000, "uniqueItems": true, "items": {"$ref": "#/$defs/repository_path"}},
        "run_temp_before_sha256": {"anyOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]},
        "run_temp_after_sha256": {"anyOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]},
        "run_temp_before_path_hashes": {"type": "array", "maxItems": 100000, "uniqueItems": true, "items": {"$ref": "#/$defs/sha256"}},
        "run_temp_after_path_hashes": {"type": "array", "maxItems": 100000, "uniqueItems": true, "items": {"$ref": "#/$defs/sha256"}},
        "run_temp_before_excluded_paths": {"type": "array", "maxItems": 5000, "uniqueItems": true, "items": {"$ref": "#/$defs/repository_path"}},
        "run_temp_after_excluded_paths": {"type": "array", "maxItems": 5000, "uniqueItems": true, "items": {"$ref": "#/$defs/repository_path"}},
        "stdout": {"$ref": "#/$defs/stream_evidence"},
        "stderr": {"$ref": "#/$defs/stream_evidence"},
        "observed_effects": {"type": "array", "maxItems": 5000, "items": {"$ref": "#/$defs/observed_effect"}}
      }
    },
    "check_result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "check_id", "fingerprint", "candidate_id", "argv", "cwd", "tier", "claim_ids",
        "timeout_seconds", "repetitions", "depends_on", "useful_after_failure",
        "expected_effects", "artifact_boundaries", "authority", "decision", "status", "attempts", "reason"
      ],
      "properties": {
        "check_id": {"type": "string", "pattern": "^K[0-9]{3,6}$"},
        "fingerprint": {"$ref": "#/$defs/sha256"},
        "candidate_id": {"type": "string", "pattern": "^Q[0-9]{3,6}$"},
        "argv": {"type": "array", "minItems": 1, "maxItems": 128, "items": {"type": "string", "minLength": 1, "maxLength": 4096}},
        "cwd": {"$ref": "#/$defs/path_or_root"},
        "tier": {"enum": ["focused", "subsystem", "project"]},
        "claim_ids": {"type": "array", "minItems": 1, "maxItems": 20000, "uniqueItems": true, "items": {"type": "string", "pattern": "^C[0-9]{3,6}$"}},
        "timeout_seconds": {"type": "integer", "minimum": 1, "maximum": 3600},
        "repetitions": {"type": "integer", "minimum": 1, "maximum": 32},
        "depends_on": {"type": "array", "maxItems": 127, "uniqueItems": true, "items": {"type": "string", "pattern": "^K[0-9]{3,6}$"}},
        "useful_after_failure": {"type": "boolean"},
        "expected_effects": {"type": "array", "minItems": 1, "maxItems": 14, "uniqueItems": true, "items": {"$ref": "#/$defs/effect_class"}},
        "artifact_boundaries": {"type": "array", "maxItems": 64, "items": {"$ref": "#/$defs/artifact_boundary"}},
        "authority": {"$ref": "#/$defs/candidate_authority"},
        "decision": {"enum": ["run", "plan_only", "authorization_required", "unsupported"]},
        "status": {"enum": ["passed", "failed", "timed_out", "unavailable", "skipped", "not_run"]},
        "attempts": {"type": "array", "maxItems": 32, "items": {"$ref": "#/$defs/attempt"}},
        "reason": {"type": "string", "minLength": 1, "maxLength": 4000}
      }
    },
    "plan_deviation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "check_id", "message", "material"],
      "properties": {
        "kind": {"enum": ["unplanned_check", "changed_command", "changed_effect", "missing_attempt", "extra_attempt", "order_change", "other"]},
        "check_id": {"type": ["string", "null"], "pattern": "^K[0-9]{3,6}$"},
        "message": {"type": "string", "minLength": 1, "maxLength": 4000},
        "material": {"type": "boolean"}
      }
    },
    "plan_adherence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["exact", "deviations"],
      "properties": {
        "exact": {"type": "boolean"},
        "deviations": {"type": "array", "maxItems": 256, "items": {"$ref": "#/$defs/plan_deviation"}}
      }
    },
    "result_coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "material_claim_ids", "supported_claim_ids", "disproved_claim_ids", "unresolved_claim_ids",
        "attempted_tiers", "completed_tiers", "required_guidance_satisfied", "sufficient"
      ],
      "properties": {
        "material_claim_ids": {"type": "array", "maxItems": 20000, "uniqueItems": true, "items": {"type": "string", "pattern": "^C[0-9]{3,6}$"}},
        "supported_claim_ids": {"type": "array", "maxItems": 20000, "uniqueItems": true, "items": {"type": "string", "pattern": "^C[0-9]{3,6}$"}},
        "disproved_claim_ids": {"type": "array", "maxItems": 20000, "uniqueItems": true, "items": {"type": "string", "pattern": "^C[0-9]{3,6}$"}},
        "unresolved_claim_ids": {"type": "array", "maxItems": 20000, "uniqueItems": true, "items": {"type": "string", "pattern": "^C[0-9]{3,6}$"}},
        "attempted_tiers": {"type": "array", "maxItems": 3, "uniqueItems": true, "items": {"enum": ["focused", "subsystem", "project"]}},
        "completed_tiers": {"type": "array", "maxItems": 3, "uniqueItems": true, "items": {"enum": ["focused", "subsystem", "project"]}},
        "required_guidance_satisfied": {"type": "boolean"},
        "sufficient": {"type": "boolean"}
      }
    },
    "mutation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["before_sha256", "after_sha256", "protected_state_unchanged", "run_temp", "allowed_effects", "unexpected_effects"],
      "properties": {
        "before_sha256": {"$ref": "#/$defs/sha256"},
        "after_sha256": {"$ref": "#/$defs/sha256"},
        "protected_state_unchanged": {"type": "boolean"},
        "run_temp": {
          "anyOf": [
            {"$ref": "#/$defs/run_temp_mutation"},
            {"type": "null"}
          ]
        },
        "allowed_effects": {"type": "array", "maxItems": 5000, "items": {"$ref": "#/$defs/observed_effect"}},
        "unexpected_effects": {"type": "array", "maxItems": 5000, "items": {"$ref": "#/$defs/observed_effect"}}
      }
    },
    "run_temp_mutation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["root_identity_sha256", "before_sha256", "after_sha256", "state_unchanged"],
      "properties": {
        "root_identity_sha256": {"$ref": "#/$defs/sha256"},
        "before_sha256": {"$ref": "#/$defs/sha256"},
        "after_sha256": {"$ref": "#/$defs/sha256"},
        "state_unchanged": {"type": "boolean"}
      }
    },
    "observation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "observation_id", "fingerprint", "category", "strength", "confidence", "title", "reason",
        "current_run_impact", "evidence", "safe_direction"
      ],
      "properties": {
        "observation_id": {"type": "string", "pattern": "^O[0-9]{3,6}$"},
        "fingerprint": {"$ref": "#/$defs/sha256"},
        "category": {"enum": ["missing_coverage", "disconnected_check", "late_feedback", "slow_feedback", "flakiness", "nondeterminism", "unsafe_mutation", "failure_visibility", "discoverability", "local_ci_drift", "other"]},
        "strength": {"enum": ["essential", "strong", "moderate", "optional"]},
        "confidence": {"enum": ["high", "medium", "low"]},
        "title": {"type": "string", "minLength": 1, "maxLength": 300},
        "reason": {"type": "string", "minLength": 1, "maxLength": 4000},
        "current_run_impact": {"enum": ["affected", "not_affected", "unknown"]},
        "evidence": {"type": "array", "minItems": 1, "maxItems": 64, "items": {"$ref": "#/$defs/evidence_reference"}},
        "safe_direction": {"type": "string", "minLength": 1, "maxLength": 4000}
      }
    },
    "limitation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["limitation_id", "code", "message", "source_ids", "target_ids", "claim_ids", "check_ids", "material", "next_action"],
      "properties": {
        "limitation_id": {"type": "string", "pattern": "^L[0-9]{3,6}$"},
        "code": {"enum": ["target_drift", "guidance_drift", "plan_drift", "protected_state_changed", "check_unavailable", "check_timeout", "execution_interrupted", "evidence_gap", "output_unavailable", "hard_limit", "authority_unavailable", "unsupported_effect", "caller_cap", "semantic_ambiguity", "other"]},
        "message": {"type": "string", "minLength": 1, "maxLength": 4000},
        "source_ids": {"type": "array", "maxItems": 5000, "uniqueItems": true, "items": {"type": "string", "pattern": "^[TSDPKA][0-9]{3,6}$"}},
        "target_ids": {"type": "array", "maxItems": 20000, "uniqueItems": true, "items": {"type": "string", "pattern": "^T[0-9]{3,6}$"}},
        "claim_ids": {"type": "array", "maxItems": 20000, "uniqueItems": true, "items": {"type": "string", "pattern": "^C[0-9]{3,6}$"}},
        "check_ids": {"type": "array", "maxItems": 128, "uniqueItems": true, "items": {"type": "string", "pattern": "^K[0-9]{3,6}$"}},
        "material": {"type": "boolean"},
        "next_action": {"enum": ["none", "triage", "plan", "decision", "authorization", "retry", "rescope", "manual"]}
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "conclusion", "claim_counts", "check_counts", "observation_count", "material_limitation_count"
      ],
      "properties": {
        "conclusion": {"type": "string", "minLength": 1, "maxLength": 4000},
        "claim_counts": {
          "type": "object",
          "additionalProperties": false,
          "required": ["supported", "disproved", "unresolved"],
          "properties": {
            "supported": {"type": "integer", "minimum": 0, "maximum": 20000},
            "disproved": {"type": "integer", "minimum": 0, "maximum": 20000},
            "unresolved": {"type": "integer", "minimum": 0, "maximum": 20000}
          }
        },
        "check_counts": {
          "type": "object",
          "additionalProperties": false,
          "required": ["passed", "failed", "timed_out", "unavailable", "skipped", "not_run"],
          "properties": {
            "passed": {"type": "integer", "minimum": 0, "maximum": 128},
            "failed": {"type": "integer", "minimum": 0, "maximum": 128},
            "timed_out": {"type": "integer", "minimum": 0, "maximum": 128},
            "unavailable": {"type": "integer", "minimum": 0, "maximum": 128},
            "skipped": {"type": "integer", "minimum": 0, "maximum": 128},
            "not_run": {"type": "integer", "minimum": 0, "maximum": 128}
          }
        },
        "observation_count": {"type": "integer", "minimum": 0, "maximum": 1000},
        "material_limitation_count": {"type": "integer", "minimum": 0, "maximum": 256}
      }
    }
  }
}
