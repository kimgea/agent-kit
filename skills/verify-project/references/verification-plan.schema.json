{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/kimgea/agent-kit/schemas/verify-project/verification-plan-1.0.0.json",
  "title": "Verify Project canonical verification plan",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "context_sha256",
    "target",
    "target_sha256",
    "targets",
    "repository_state",
    "invocation",
    "policy",
    "guidance",
    "discovery",
    "claims",
    "guidance_interpretations",
    "checks",
    "coverage",
    "limitations",
    "execution_state",
    "summary"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "context_sha256": {"$ref": "#/$defs/sha256"},
    "target": {"$ref": "#/$defs/target"},
    "target_sha256": {"$ref": "#/$defs/sha256"},
    "targets": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20000,
      "items": {"$ref": "#/$defs/target_record"}
    },
    "repository_state": {"$ref": "#/$defs/repository_state"},
    "invocation": {"$ref": "#/$defs/invocation"},
    "policy": {"type": "array", "minItems": 1, "maxItems": 64, "items": {"$ref": "#/$defs/policy_source"}},
    "guidance": {"$ref": "#/$defs/guidance_provenance"},
    "discovery": {"type": "array", "maxItems": 5000, "items": {"$ref": "#/$defs/discovery_source"}},
    "claims": {
      "type": "array",
      "maxItems": 20000,
      "items": {"$ref": "#/$defs/claim"}
    },
    "guidance_interpretations": {
      "type": "array",
      "maxItems": 5000,
      "items": {"$ref": "#/$defs/guidance_interpretation"}
    },
    "checks": {
      "type": "array",
      "maxItems": 128,
      "items": {"$ref": "#/$defs/check"}
    },
    "coverage": {"$ref": "#/$defs/plan_coverage"},
    "limitations": {
      "type": "array",
      "maxItems": 256,
      "items": {"$ref": "#/$defs/limitation"}
    },
    "execution_state": {"enum": ["ready", "plan_only", "blocked"]},
    "summary": {"$ref": "#/$defs/summary"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "repository_path": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096,
      "pattern": "^(?!/)(?![A-Za-z]:)(?!.*\\\\)(?!.*[\\u0000-\\u001F\\u007F])(?!.*//)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*/$).+$"
    },
    "path_or_root": {
      "anyOf": [
        {"const": "."},
        {"$ref": "#/$defs/repository_path"}
      ]
    },
    "nullable_revision": {"type": ["string", "null"], "minLength": 1, "maxLength": 512},
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "repository_root", "base_revision", "requested_paths"],
      "properties": {
        "kind": {"enum": ["working_tree", "paths"]},
        "repository_root": {"type": "string", "minLength": 1, "maxLength": 4096},
        "base_revision": {"$ref": "#/$defs/nullable_revision"},
        "requested_paths": {"type": "array", "minItems": 1, "maxItems": 20000, "uniqueItems": true, "items": {"$ref": "#/$defs/path_or_root"}}
      }
    },
    "target_record": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "target_id", "path", "old_path", "change_kind", "presence", "file_kind",
        "inspection_kind", "size_bytes", "mode", "sha256", "guidance_chain_id", "old_guidance_chain_id"
      ],
      "properties": {
        "target_id": {"type": "string", "pattern": "^T[0-9]{3,6}$"},
        "path": {"$ref": "#/$defs/path_or_root"},
        "old_path": {"anyOf": [{"$ref": "#/$defs/repository_path"}, {"type": "null"}]},
        "change_kind": {"enum": ["added", "modified", "deleted", "renamed", "type_changed", "mode_changed", "untracked", "snapshot", "unknown"]},
        "presence": {"enum": ["present", "absent"]},
        "file_kind": {"enum": ["regular", "directory", "absent", "other"]},
        "inspection_kind": {"enum": ["text", "binary", "metadata_only", "absent", "unreadable", "oversized", "unsupported"]},
        "size_bytes": {"type": ["integer", "null"], "minimum": 0, "maximum": 268435456},
        "mode": {"type": ["integer", "null"], "minimum": 0, "maximum": 65535},
        "sha256": {"anyOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]},
        "guidance_chain_id": {"type": "string", "pattern": "^G[0-9]{3,6}$"},
        "old_guidance_chain_id": {"type": ["string", "null"], "pattern": "^G[0-9]{3,6}$"}
      }
    },
    "repository_state": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository_identity_sha256", "git_repository", "head_revision", "protected_state_sha256", "protected_path_hashes"],
      "properties": {
        "repository_identity_sha256": {"$ref": "#/$defs/sha256"},
        "git_repository": {"type": "boolean"},
        "head_revision": {"$ref": "#/$defs/nullable_revision"},
        "protected_state_sha256": {"$ref": "#/$defs/sha256"},
        "protected_path_hashes": {"type": "array", "maxItems": 100000, "uniqueItems": true, "items": {"$ref": "#/$defs/sha256"}}
      }
    },
    "freshness": {
      "type": "object",
      "additionalProperties": false,
      "required": ["context_kind", "producer", "producer_version", "consumer"],
      "properties": {
        "context_kind": {"enum": ["fresh", "existing"]},
        "producer": {"type": "string", "minLength": 1, "maxLength": 128},
        "producer_version": {"type": ["string", "null"], "minLength": 1, "maxLength": 128},
        "consumer": {"type": ["string", "null"], "minLength": 1, "maxLength": 128}
      }
    },
    "invocation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "freshness", "tier_cap", "command_cap", "time_cap_seconds"],
      "properties": {
        "mode": {"enum": ["plan", "execute"]},
        "freshness": {"$ref": "#/$defs/freshness"},
        "tier_cap": {"type": ["string", "null"], "enum": ["focused", "subsystem", "project", null]},
        "command_cap": {"type": ["integer", "null"], "minimum": 0, "maximum": 128},
        "time_cap_seconds": {"type": ["integer", "null"], "minimum": 0, "maximum": 86400}
      }
    },
    "policy_source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["policy_id", "kind", "label", "sha256"],
      "properties": {
        "policy_id": {"type": "string", "pattern": "^P[0-9]{3,6}$"},
        "kind": {"enum": ["caller", "user_global", "project"]},
        "label": {"type": "string", "minLength": 1, "maxLength": 512},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "discovery_source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["discovery_id", "kind", "path", "sha256", "inspection_kind", "provenance"],
      "properties": {
        "discovery_id": {"type": "string", "pattern": "^D[0-9]{3,6}$"},
        "kind": {"enum": ["manifest", "script", "test_configuration", "build_configuration", "lint_configuration", "type_configuration", "local_ci", "related_test", "documentation", "contract", "source", "other"]},
        "path": {"$ref": "#/$defs/repository_path"},
        "sha256": {"anyOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]},
        "inspection_kind": {"enum": ["text", "binary", "metadata_only", "unreadable", "oversized", "unsupported"]},
        "provenance": {"enum": ["caller", "agent_policy", "verify_guidance", "project_entry_point", "related_context"]}
      }
    },
    "guidance_source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_id", "kind", "path", "provenance", "revision", "sha256"],
      "properties": {
        "source_id": {"type": "string", "pattern": "^S[0-9]{3,6}$"},
        "kind": {"enum": ["skill", "repository"]},
        "path": {"$ref": "#/$defs/repository_path"},
        "provenance": {"enum": ["locked_skill", "git_head", "current_filesystem"]},
        "revision": {"$ref": "#/$defs/nullable_revision"},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "guidance_chain": {
      "type": "object",
      "additionalProperties": false,
      "required": ["chain_id", "target_ids", "source_ids", "complete"],
      "properties": {
        "chain_id": {"type": "string", "pattern": "^G[0-9]{3,6}$"},
        "target_ids": {"type": "array", "minItems": 1, "maxItems": 20000, "uniqueItems": true, "items": {"type": "string", "pattern": "^T[0-9]{3,6}$"}},
        "source_ids": {"type": "array", "minItems": 1, "maxItems": 256, "uniqueItems": true, "items": {"type": "string", "pattern": "^S[0-9]{3,6}$"}},
        "complete": {"type": "boolean"}
      }
    },
    "guidance_provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sources", "chains"],
      "properties": {
        "sources": {"type": "array", "minItems": 1, "maxItems": 5000, "items": {"$ref": "#/$defs/guidance_source"}},
        "chains": {"type": "array", "minItems": 1, "maxItems": 20000, "items": {"$ref": "#/$defs/guidance_chain"}}
      }
    },
    "location": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "start_line", "end_line"],
      "properties": {
        "path": {"$ref": "#/$defs/path_or_root"},
        "start_line": {"type": ["integer", "null"], "minimum": 1},
        "end_line": {"type": ["integer", "null"], "minimum": 1}
      }
    },
    "claim_basis": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "description", "source_id", "location"],
      "properties": {
        "kind": {"enum": ["caller", "agent_policy", "verify_guidance", "target_content", "project_contract", "related_test", "reasoning"]},
        "description": {"type": "string", "minLength": 1, "maxLength": 4000},
        "source_id": {"type": ["string", "null"], "pattern": "^[SDP][0-9]{3,6}$"},
        "location": {
          "anyOf": [
            {"$ref": "#/$defs/location"},
            {"type": "null"}
          ]
        }
      }
    },
    "claim": {
      "type": "object",
      "additionalProperties": false,
      "required": ["claim_id", "fingerprint", "statement", "material", "target_ids", "basis", "evidence_requirement"],
      "properties": {
        "claim_id": {"type": "string", "pattern": "^C[0-9]{3,6}$"},
        "fingerprint": {"$ref": "#/$defs/sha256"},
        "statement": {"type": "string", "minLength": 1, "maxLength": 4000},
        "material": {"type": "boolean"},
        "target_ids": {"type": "array", "minItems": 1, "maxItems": 20000, "uniqueItems": true, "items": {"type": "string", "pattern": "^T[0-9]{3,6}$"}},
        "basis": {"type": "array", "minItems": 1, "maxItems": 64, "items": {"$ref": "#/$defs/claim_basis"}},
        "evidence_requirement": {"enum": ["static", "command", "either"]}
      }
    },
    "guidance_interpretation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["interpretation_id", "source_id", "target_ids", "claim_ids", "kind", "requirement", "replaces_interpretation_id", "replacement_reason"],
      "properties": {
        "interpretation_id": {"type": "string", "pattern": "^I[0-9]{3,6}$"},
        "source_id": {"type": "string", "pattern": "^S[0-9]{3,6}$"},
        "target_ids": {"type": "array", "minItems": 1, "maxItems": 20000, "uniqueItems": true, "items": {"type": "string", "pattern": "^T[0-9]{3,6}$"}},
        "claim_ids": {"type": "array", "maxItems": 20000, "uniqueItems": true, "items": {"type": "string", "pattern": "^C[0-9]{3,6}$"}},
        "kind": {"enum": ["required", "conditional", "recommended", "replacement", "artifact"]},
        "requirement": {"type": "string", "minLength": 1, "maxLength": 4000},
        "replaces_interpretation_id": {"type": ["string", "null"], "pattern": "^I[0-9]{3,6}$"},
        "replacement_reason": {"type": ["string", "null"], "minLength": 1, "maxLength": 4000}
      }
    },
    "effect_class": {
      "enum": [
        "repository_read", "local_process", "disposable_repository_write", "bounded_temporary_write",
        "source_mutation", "configuration_mutation", "dependency_installation", "network_access",
        "external_service", "persistent_process", "destructive_action", "permission_change",
        "remote_mutation", "outside_bounded_roots"
      ]
    },
    "artifact_boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["root_kind", "path"],
      "properties": {
        "root_kind": {"enum": ["repository", "run_temp"]},
        "path": {"$ref": "#/$defs/repository_path"}
      }
    },
    "candidate_authority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_kind", "source", "authorized"],
      "properties": {
        "source_kind": {"enum": ["caller", "user_global", "none"]},
        "source": {"type": "string", "minLength": 1, "maxLength": 4000},
        "authorized": {"type": "boolean"}
      }
    },
    "check": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "check_id", "fingerprint", "candidate_id", "argv", "cwd", "tier", "reason",
        "claim_ids", "timeout_seconds", "repetitions", "depends_on", "useful_after_failure",
        "expected_effects", "artifact_boundaries", "authority", "decision"
      ],
      "properties": {
        "check_id": {"type": "string", "pattern": "^K[0-9]{3,6}$"},
        "fingerprint": {"$ref": "#/$defs/sha256"},
        "candidate_id": {"type": "string", "pattern": "^Q[0-9]{3,6}$"},
        "argv": {"type": "array", "minItems": 1, "maxItems": 128, "items": {"type": "string", "minLength": 1, "maxLength": 4096}},
        "cwd": {"$ref": "#/$defs/path_or_root"},
        "tier": {"enum": ["focused", "subsystem", "project"]},
        "reason": {"type": "string", "minLength": 1, "maxLength": 4000},
        "claim_ids": {"type": "array", "minItems": 1, "maxItems": 20000, "uniqueItems": true, "items": {"type": "string", "pattern": "^C[0-9]{3,6}$"}},
        "timeout_seconds": {"type": "integer", "minimum": 1, "maximum": 3600},
        "repetitions": {"type": "integer", "minimum": 1, "maximum": 32},
        "depends_on": {"type": "array", "maxItems": 127, "uniqueItems": true, "items": {"type": "string", "pattern": "^K[0-9]{3,6}$"}},
        "useful_after_failure": {"type": "boolean"},
        "expected_effects": {"type": "array", "minItems": 1, "maxItems": 14, "uniqueItems": true, "items": {"$ref": "#/$defs/effect_class"}},
        "artifact_boundaries": {"type": "array", "maxItems": 64, "items": {"$ref": "#/$defs/artifact_boundary"}},
        "authority": {"$ref": "#/$defs/candidate_authority"},
        "decision": {"enum": ["run", "plan_only", "authorization_required", "unsupported"]}
      }
    },
    "plan_coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["material_claim_ids", "planned_claim_ids", "uncovered_claim_ids", "highest_tier"],
      "properties": {
        "material_claim_ids": {"type": "array", "maxItems": 20000, "uniqueItems": true, "items": {"type": "string", "pattern": "^C[0-9]{3,6}$"}},
        "planned_claim_ids": {"type": "array", "maxItems": 20000, "uniqueItems": true, "items": {"type": "string", "pattern": "^C[0-9]{3,6}$"}},
        "uncovered_claim_ids": {"type": "array", "maxItems": 20000, "uniqueItems": true, "items": {"type": "string", "pattern": "^C[0-9]{3,6}$"}},
        "highest_tier": {"type": ["string", "null"], "enum": ["focused", "subsystem", "project", null]}
      }
    },
    "limitation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "message", "source_ids", "target_ids", "claim_ids", "material", "next_action"],
      "properties": {
        "code": {"enum": ["target_unavailable", "target_limit", "guidance_unavailable", "guidance_conflict", "guidance_limit", "discovery_unavailable", "discovery_limit", "coverage_gap", "authority_unavailable", "unsafe_candidate", "unsupported_effect", "caller_cap", "context_drift", "semantic_ambiguity", "other"]},
        "message": {"type": "string", "minLength": 1, "maxLength": 4000},
        "source_ids": {"type": "array", "maxItems": 5000, "uniqueItems": true, "items": {"type": "string", "pattern": "^[SDPQI][0-9]{3,6}$"}},
        "target_ids": {"type": "array", "maxItems": 20000, "uniqueItems": true, "items": {"type": "string", "pattern": "^T[0-9]{3,6}$"}},
        "claim_ids": {"type": "array", "maxItems": 20000, "uniqueItems": true, "items": {"type": "string", "pattern": "^C[0-9]{3,6}$"}},
        "material": {"type": "boolean"},
        "next_action": {"enum": ["none", "plan", "decision", "authorization", "rescope", "manual"]}
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["conclusion", "claim_count", "material_claim_count", "check_count", "runnable_check_count", "material_limitation_count"],
      "properties": {
        "conclusion": {"type": "string", "minLength": 1, "maxLength": 4000},
        "claim_count": {"type": "integer", "minimum": 0, "maximum": 20000},
        "material_claim_count": {"type": "integer", "minimum": 0, "maximum": 20000},
        "check_count": {"type": "integer", "minimum": 0, "maximum": 128},
        "runnable_check_count": {"type": "integer", "minimum": 0, "maximum": 128},
        "material_limitation_count": {"type": "integer", "minimum": 0, "maximum": 256}
      }
    }
  }
}
