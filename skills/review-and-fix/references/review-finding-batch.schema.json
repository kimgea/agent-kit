{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/kimgea/agent-kit/schemas/review-and-fix/review-finding-batch-1.0.0.json",
  "title": "Neutral review finding batch",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "target", "source", "normalization", "status", "findings", "limitations"],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "target": { "$ref": "#/$defs/target" },
    "source": { "$ref": "#/$defs/source" },
    "normalization": { "$ref": "#/$defs/normalization" },
    "status": { "enum": ["complete", "partial"] },
    "findings": {
      "type": "array",
      "maxItems": 1000,
      "items": { "$ref": "#/$defs/finding" }
    },
    "limitations": {
      "type": "array",
      "maxItems": 256,
      "items": { "$ref": "#/$defs/limitation" }
    }
  },
  "$defs": {
    "path": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096,
      "pattern": "^(?!/)(?![A-Za-z]:)(?!.*\\\\)(?!.*[\\u0000-\\u001F\\u007F])(?!.*//)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*/$).+$"
    },
    "nullable_revision": { "type": ["string", "null"], "minLength": 1, "maxLength": 512 },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "repository_root", "base_revision", "head_revision", "working_tree_mode", "requested_paths"],
      "properties": {
        "kind": { "enum": ["ref_range", "working_tree", "paths"] },
        "repository_root": { "type": "string", "minLength": 1, "maxLength": 4096 },
        "base_revision": { "$ref": "#/$defs/nullable_revision" },
        "head_revision": { "$ref": "#/$defs/nullable_revision" },
        "working_tree_mode": { "type": ["string", "null"], "enum": ["staged", "unstaged", "combined", null] },
        "requested_paths": { "type": "array", "minItems": 1, "maxItems": 5000, "uniqueItems": true, "items": { "$ref": "#/$defs/path" } }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reviewer", "reviewer_version", "output_format", "output_sha256", "completed", "verdict"],
      "properties": {
        "reviewer": { "type": "string", "minLength": 1, "maxLength": 128 },
        "reviewer_version": { "type": ["string", "null"], "minLength": 1, "maxLength": 128 },
        "output_format": { "enum": ["project_review_json", "neutral_json", "structured", "prose"] },
        "output_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "completed": { "type": "boolean" },
        "verdict": { "type": ["string", "null"], "minLength": 1, "maxLength": 128 }
      }
    },
    "normalization": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "confidence", "notes"],
      "properties": {
        "mode": { "enum": ["deterministic", "native", "independent_agent"] },
        "confidence": { "enum": ["high", "medium", "low"] },
        "notes": { "type": "array", "maxItems": 256, "items": { "type": "string", "minLength": 1, "maxLength": 2000 } }
      }
    },
    "location": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "start_line", "end_line"],
      "properties": {
        "path": { "$ref": "#/$defs/path" },
        "start_line": { "type": ["integer", "null"], "minimum": 1 },
        "end_line": { "type": ["integer", "null"], "minimum": 1 }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "description", "location"],
      "properties": {
        "kind": { "enum": ["code", "test", "rule", "history", "command", "reasoning", "reviewer_statement"] },
        "description": { "type": "string", "minLength": 1, "maxLength": 4000 },
        "location": { "oneOf": [{ "$ref": "#/$defs/location" }, { "type": "null" }] }
      }
    },
    "field_provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["disposition", "severity", "confidence", "scope_relation", "actionability", "safe_direction"],
      "properties": {
        "disposition": { "enum": ["explicit", "inferred", "missing"] },
        "severity": { "enum": ["explicit", "inferred", "missing"] },
        "confidence": { "enum": ["explicit", "inferred", "missing"] },
        "scope_relation": { "enum": ["explicit", "inferred", "missing"] },
        "actionability": { "enum": ["explicit", "inferred", "missing"] },
        "safe_direction": { "enum": ["explicit", "inferred", "missing"] }
      }
    },
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["finding_id", "fingerprint", "source_id", "source_fingerprint", "disposition", "severity", "confidence", "scope_relation", "actionability", "title", "problem", "impact", "evidence", "primary_location", "related_locations", "safe_direction", "field_provenance", "normalization_confidence", "normalization_notes"],
      "properties": {
        "finding_id": { "type": "string", "pattern": "^RF[0-9]{3,6}$" },
        "fingerprint": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "source_id": { "type": ["string", "null"], "minLength": 1, "maxLength": 256 },
        "source_fingerprint": { "type": ["string", "null"], "pattern": "^[0-9a-f]{64}$" },
        "disposition": { "enum": ["blocker", "suggestion", "nit", "unknown"] },
        "severity": { "enum": ["critical", "high", "medium", "low", "unknown"] },
        "confidence": { "enum": ["high", "medium", "low", "unknown"] },
        "scope_relation": { "enum": ["introduced", "worsened", "pre_existing", "uncertain", "unknown"] },
        "actionability": { "enum": ["actionable", "needs_triage", "informational"] },
        "title": { "type": "string", "minLength": 1, "maxLength": 300 },
        "problem": { "type": "string", "minLength": 1, "maxLength": 8000 },
        "impact": { "type": "string", "minLength": 1, "maxLength": 4000 },
        "evidence": { "type": "array", "maxItems": 32, "items": { "$ref": "#/$defs/evidence" } },
        "primary_location": { "oneOf": [{ "$ref": "#/$defs/location" }, { "type": "null" }] },
        "related_locations": { "type": "array", "maxItems": 32, "items": { "$ref": "#/$defs/location" } },
        "safe_direction": { "type": ["string", "null"], "minLength": 1, "maxLength": 4000 },
        "field_provenance": { "$ref": "#/$defs/field_provenance" },
        "normalization_confidence": { "enum": ["high", "medium", "low"] },
        "normalization_notes": { "type": "array", "maxItems": 64, "items": { "type": "string", "minLength": 1, "maxLength": 2000 } }
      }
    },
    "limitation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "message", "source_ids", "material"],
      "properties": {
        "code": { "enum": ["source_incomplete", "source_limitation", "target_mismatch", "output_ambiguous", "missing_evidence", "missing_location", "contradictory_output", "normalizer_unavailable", "other"] },
        "message": { "type": "string", "minLength": 1, "maxLength": 4000 },
        "source_ids": { "type": "array", "maxItems": 1000, "uniqueItems": true, "items": { "type": "string", "minLength": 1, "maxLength": 256 } },
        "material": { "type": "boolean" }
      }
    }
  }
}
