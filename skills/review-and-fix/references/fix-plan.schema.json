{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/kimgea/agent-kit/schemas/review-and-fix/fix-plan-1.0.0.json",
  "title": "Review finding fix plan",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "batch_sha256", "finding", "assessment", "proposal", "decision", "decision_reasons"],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "batch_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "finding": { "$ref": "#/$defs/finding_ref" },
    "assessment": { "$ref": "#/$defs/assessment" },
    "proposal": { "$ref": "#/$defs/proposal" },
    "decision": { "enum": ["auto", "user_decision_required", "authorization_required"] },
    "decision_reasons": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1, "maxLength": 200 } }
  },
  "$defs": {
    "path": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096,
      "pattern": "^(?!/)(?![A-Za-z]:)(?!.*\\\\)(?!.*[\\u0000-\\u001F\\u007F])(?!.*//)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*/$).+$"
    },
    "selection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_kind", "basis", "source"],
      "properties": {
        "source_kind": { "enum": ["default", "caller"] },
        "basis": { "enum": ["default_policy", "caller_explicit", "path_snapshot_request"] },
        "source": { "type": "string", "minLength": 1, "maxLength": 1000 }
      }
    },
    "finding_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["finding_id", "fingerprint", "disposition", "scope_relation", "normalization_confidence", "actionability", "selection"],
      "properties": {
        "finding_id": { "type": "string", "pattern": "^RF[0-9]{3,6}$" },
        "fingerprint": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "disposition": { "enum": ["blocker", "suggestion", "nit", "unknown"] },
        "scope_relation": { "enum": ["introduced", "worsened", "pre_existing", "uncertain", "unknown"] },
        "normalization_confidence": { "enum": ["high", "medium", "low"] },
        "actionability": { "enum": ["actionable", "needs_triage", "informational"] },
        "selection": { "$ref": "#/$defs/selection" }
      }
    },
    "assessment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["intent_status", "intent_source", "behavior_effect", "change_kind", "remedy_shape", "scope_size", "reversible", "validation", "plan_confidence", "risk_factors"],
      "properties": {
        "intent_status": { "enum": ["explicit", "inferred", "uncertain"] },
        "intent_source": { "enum": ["user", "test", "specification", "review_rule", "public_contract", "existing_behavior", "none"] },
        "behavior_effect": { "enum": ["none", "restorative", "new_or_changed", "uncertain"] },
        "change_kind": { "enum": ["text_only", "mechanical", "code", "configuration", "other"] },
        "remedy_shape": { "enum": ["singular", "multiple", "unknown"] },
        "scope_size": { "enum": ["small", "medium", "large", "unknown"] },
        "reversible": { "type": "boolean" },
        "validation": { "enum": ["available", "static_sufficient", "unavailable", "uncertain"] },
        "plan_confidence": { "enum": ["high", "medium", "low"] },
        "risk_factors": {
          "type": "array",
          "maxItems": 64,
          "uniqueItems": true,
          "items": {
            "enum": ["product_behavior", "public_api", "schema_or_format", "compatibility", "security", "privacy", "durable_data", "concurrency", "failure_policy", "dependency", "external_service", "architecture", "broad_scope", "difficult_rollback", "user_change_overlap", "uncertain_intent", "validation_gap", "destructive_action", "remote_state", "permission_change", "dependency_installation", "persistent_service", "other"]
          }
        }
      }
    },
    "proposal": {
      "type": "object",
      "additionalProperties": false,
      "required": ["summary", "rationale", "paths", "steps", "alternatives", "validation_steps"],
      "properties": {
        "summary": { "type": "string", "minLength": 1, "maxLength": 2000 },
        "rationale": { "type": "string", "minLength": 1, "maxLength": 4000 },
        "paths": { "type": "array", "minItems": 1, "maxItems": 256, "uniqueItems": true, "items": { "$ref": "#/$defs/path" } },
        "steps": { "type": "array", "minItems": 1, "maxItems": 128, "items": { "type": "string", "minLength": 1, "maxLength": 2000 } },
        "alternatives": { "type": "array", "maxItems": 32, "items": { "type": "string", "minLength": 1, "maxLength": 2000 } },
        "validation_steps": { "type": "array", "minItems": 1, "maxItems": 128, "items": { "type": "string", "minLength": 1, "maxLength": 2000 } }
      }
    }
  }
}
