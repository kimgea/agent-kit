{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-kit.invalid/schemas/project-eval-suite-v1.json",
  "title": "Project eval suite v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "suite_id", "title", "cases", "profiles"],
  "properties": {
    "schema_version": {"const": "project-eval-suite/v1"},
    "suite_id": {"type": "string", "pattern": "^[a-z][a-z0-9-]{0,63}$"},
    "title": {"type": "string", "minLength": 1, "maxLength": 200},
    "cases": {
      "type": "array",
      "minItems": 1,
      "maxItems": 500,
      "items": {"$ref": "#/$defs/case"}
    },
    "profiles": {
      "type": "object",
      "minProperties": 1,
      "maxProperties": 32,
      "additionalProperties": {"$ref": "#/$defs/profile"}
    }
  },
  "$defs": {
    "case": {
      "type": "object",
      "additionalProperties": false,
      "required": ["case_id", "title", "kind", "importance", "fixture", "task", "coverage", "platforms", "required_capabilities", "assertion_ids"],
      "properties": {
        "case_id": {"type": "string", "pattern": "^[a-z][a-z0-9-]{0,63}$"},
        "title": {"type": "string", "minLength": 1, "maxLength": 200},
        "kind": {"enum": ["explanation", "implementation", "trajectory"]},
        "importance": {"enum": ["required", "important", "standard", "exploratory"]},
        "fixture": {"$ref": "#/$defs/path"},
        "task": {"type": "string", "minLength": 1, "maxLength": 20000},
        "coverage": {"enum": ["development", "holdout", "regression"]},
        "platforms": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["linux", "windows", "macos"]}},
        "required_capabilities": {"type": "array", "maxItems": 64, "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z][a-z0-9._-]{0,63}$"}},
        "assertion_ids": {"type": "array", "minItems": 1, "maxItems": 256, "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z][a-z0-9._-]{0,63}$"}}
      }
    },
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["case_ids", "repetitions", "max_invocations", "max_seconds", "max_tokens", "max_cost_usd", "network", "effects"],
      "properties": {
        "case_ids": {"type": "array", "minItems": 1, "maxItems": 500, "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z][a-z0-9-]{0,63}$"}},
        "repetitions": {"type": "integer", "minimum": 1, "maximum": 100},
        "max_invocations": {"type": "integer", "minimum": 1, "maximum": 10000},
        "max_seconds": {"type": "integer", "minimum": 1, "maximum": 86400},
        "max_tokens": {"type": ["integer", "null"], "minimum": 1, "maximum": 1000000000},
        "max_cost_usd": {"type": ["number", "null"], "minimum": 0, "maximum": 1000000},
        "network": {"type": "boolean"},
        "effects": {"type": "array", "maxItems": 16, "uniqueItems": true, "items": {"enum": ["workspace_edit", "command_execution", "local_output", "external_read"]}}
      }
    },
    "path": {"type": "string", "pattern": "^(?!/)(?![A-Za-z]:)(?!.*(?:^|/)[.]{1,2}(?:/|$))(?!.*\\\\)[^\\u0000-\\u001f\\u007f]+$", "maxLength": 4096}
  }
}
