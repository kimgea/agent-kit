{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-kit.invalid/schemas/eval-candidate-result-v1.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "producer", "completion", "outcome", "next_action", "source_digest", "target", "candidates", "limitations"],
  "properties": {
    "schema_version": {"const": "eval-candidate-result/v1"},
    "producer": {"$ref": "#/$defs/producer"},
    "completion": {"enum": ["complete", "incomplete"]},
    "outcome": {"enum": ["candidates", "none", "unknown"]},
    "next_action": {"enum": ["none", "draft", "decision", "retry", "manual"]},
    "source_digest": {"$ref": "#/$defs/sha"},
    "target": {"type": "object", "additionalProperties": false, "required": ["repository_sha256", "suite_sha256"], "properties": {"repository_sha256": {"$ref": "#/$defs/sha"}, "suite_sha256": {"anyOf": [{"$ref": "#/$defs/sha"}, {"type": "null"}]}}},
    "candidates": {"type": "array", "maxItems": 2000, "items": {"$ref": "#/$defs/candidate"}},
    "limitations": {"type": "array", "maxItems": 2000, "items": {"$ref": "#/$defs/limitation"}}
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[a-z][a-z0-9._-]{0,63}$"},
    "sha": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "producer": {"type": "object", "additionalProperties": false, "required": ["name", "version"], "properties": {"name": {"type": "string", "pattern": "^[a-z][a-z0-9-]{0,63}$"}, "version": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:+/@-]{0,127}$"}}},
    "evidence": {"type": "object", "additionalProperties": false, "required": ["evidence_id", "kind", "sha256", "summary", "redacted"], "properties": {"evidence_id": {"$ref": "#/$defs/id"}, "kind": {"enum": ["session_summary", "run_receipt", "assertion", "measurement", "repository"]}, "sha256": {"$ref": "#/$defs/sha"}, "summary": {"type": "string", "minLength": 1, "maxLength": 500}, "redacted": {"const": true}}},
    "limitation": {"type": "object", "additionalProperties": false, "required": ["code", "message", "material"], "properties": {"code": {"$ref": "#/$defs/id"}, "message": {"type": "string", "minLength": 1, "maxLength": 2000}, "material": {"type": "boolean"}}},
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["candidate_id", "pain_point", "proposed_case", "reason", "evidence", "evidence_count", "independent_session_count", "overlap", "confidence", "proposed_importance", "behavior_basis", "cost_effect", "promotion_requirements", "readiness"],
      "properties": {
        "candidate_id": {"$ref": "#/$defs/id"},
        "pain_point": {"type": "string", "minLength": 1, "maxLength": 2000},
        "proposed_case": {"type": "object", "additionalProperties": false, "required": ["kind", "phase", "task_summary"], "properties": {"kind": {"enum": ["explanation", "implementation", "trajectory"]}, "phase": {"type": ["string", "null"], "enum": ["intake", "clarification", "specification", "planning", "implementation", "verification", "reporting", null]}, "task_summary": {"type": "string", "minLength": 1, "maxLength": 2000}}},
        "reason": {"type": "string", "minLength": 1, "maxLength": 2000},
        "evidence": {"type": "array", "minItems": 1, "maxItems": 256, "items": {"$ref": "#/$defs/evidence"}},
        "evidence_count": {"type": "integer", "minimum": 1, "maximum": 1000000},
        "independent_session_count": {"type": "integer", "minimum": 1, "maximum": 1000000},
        "overlap": {"type": "object", "additionalProperties": false, "required": ["relation", "case_ids", "reason"], "properties": {"relation": {"enum": ["none", "partial", "duplicate", "extends"]}, "case_ids": {"type": "array", "maxItems": 256, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}}, "reason": {"type": "string", "minLength": 1, "maxLength": 1000}}},
        "confidence": {"enum": ["high", "medium", "low", "unknown"]},
        "proposed_importance": {"enum": ["required", "important", "standard", "exploratory"]},
        "behavior_basis": {"enum": ["existing", "new", "ambiguous"]},
        "cost_effect": {"enum": ["decrease", "none", "increase", "unknown"]},
        "promotion_requirements": {"type": "array", "maxItems": 64, "items": {"type": "string", "minLength": 1, "maxLength": 500}},
        "readiness": {"enum": ["ready", "decision_required", "needs_evidence"]}
      }
    }
  }
}
