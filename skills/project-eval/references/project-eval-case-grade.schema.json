{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-kit.invalid/schemas/project-eval-case-grade-v1.json",
  "title": "Project eval case grade v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "case_id", "status", "workspace_initial_sha256", "workspace_sha256", "control_sha256", "fixture_sha256", "preparation_sha256", "grader_sha256", "evidence"],
  "properties": {
    "schema_version": {"const": "project-eval-case-grade/v1"},
    "case_id": {"type": "string", "pattern": "^[a-z][a-z0-9._-]{0,63}$"},
    "status": {"enum": ["passed", "failed"]},
    "workspace_initial_sha256": {"$ref": "#/$defs/sha"},
    "workspace_sha256": {"$ref": "#/$defs/sha"},
    "control_sha256": {"$ref": "#/$defs/sha"},
    "fixture_sha256": {"$ref": "#/$defs/sha"},
    "preparation_sha256": {"$ref": "#/$defs/sha"},
    "grader_sha256": {"$ref": "#/$defs/sha"},
    "evidence": {"type": "array", "minItems": 1, "maxItems": 290, "items": {"$ref": "#/$defs/evidence"}}
  },
  "$defs": {
    "sha": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["evidence_id", "kind", "status", "sha256", "summary", "redacted"],
      "properties": {
        "evidence_id": {"type": "string", "pattern": "^[a-z][a-z0-9._-]{0,63}$"},
        "kind": {"enum": ["assertion", "check", "failure"]},
        "status": {"enum": ["pass", "fail", "unknown"]},
        "sha256": {"$ref": "#/$defs/sha"},
        "summary": {"type": "string", "minLength": 1, "maxLength": 1000},
        "redacted": {"const": true}
      }
    }
  }
}
