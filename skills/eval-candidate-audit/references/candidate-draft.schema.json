{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-kit.invalid/schemas/eval-candidate-draft-v1.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["completion", "candidates", "limitations"],
  "properties": {
    "completion": {"enum": ["complete", "incomplete"]},
    "candidates": {"type": "array", "maxItems": 2000, "items": {"$ref": "#/$defs/candidate"}},
    "limitations": {"type": "array", "maxItems": 2000, "items": {"$ref": "#/$defs/limitation"}}
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[a-z][a-z0-9._-]{0,63}$"},
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pain_point", "proposed_case", "reason", "evidence_ids", "overlap", "proposed_importance", "behavior_basis", "cost_effect", "promotion_requirements"],
      "properties": {
        "pain_point": {"type": "string", "minLength": 1, "maxLength": 2000},
        "proposed_case": {"type": "object", "additionalProperties": false, "required": ["kind", "phase", "task_summary"], "properties": {"kind": {"enum": ["explanation", "implementation", "trajectory"]}, "phase": {"type": ["string", "null"], "enum": ["intake", "clarification", "specification", "planning", "implementation", "verification", "reporting", null]}, "task_summary": {"type": "string", "minLength": 1, "maxLength": 2000}}},
        "reason": {"type": "string", "minLength": 1, "maxLength": 2000},
        "evidence_ids": {"type": "array", "minItems": 1, "maxItems": 256, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}},
        "overlap": {"type": "object", "additionalProperties": false, "required": ["relation", "case_ids", "reason"], "properties": {"relation": {"enum": ["none", "partial", "duplicate", "extends"]}, "case_ids": {"type": "array", "maxItems": 256, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}}, "reason": {"type": "string", "minLength": 1, "maxLength": 1000}}},
        "proposed_importance": {"enum": ["required", "important", "standard", "exploratory"]},
        "behavior_basis": {"enum": ["existing", "new", "ambiguous"]},
        "cost_effect": {"enum": ["decrease", "none", "increase", "unknown"]},
        "promotion_requirements": {"type": "array", "maxItems": 64, "items": {"type": "string", "minLength": 1, "maxLength": 500}}
      }
    },
    "limitation": {"type": "object", "additionalProperties": false, "required": ["code", "message", "material"], "properties": {"code": {"$ref": "#/$defs/id"}, "message": {"type": "string", "minLength": 1, "maxLength": 2000}, "material": {"type": "boolean"}}}
  }
}
