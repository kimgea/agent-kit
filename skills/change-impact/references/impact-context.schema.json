{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/kimgea/agent-kit/change-impact/impact-context.schema.json",
  "title": "Change Impact Context",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "skill_version", "request", "target", "files", "guidance", "limits", "limitations"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "skill_version": {"const": "1.0.0"},
    "request": {"$ref": "#/$defs/request"},
    "target": {"$ref": "#/$defs/target"},
    "files": {"type": "array", "maxItems": 11000, "items": {"$ref": "#/$defs/file"}},
    "guidance": {"type": "array", "maxItems": 10000, "items": {"$ref": "#/$defs/guidance"}},
    "limits": {"$ref": "#/$defs/limits"},
    "limitations": {"type": "array", "maxItems": 256, "items": {"$ref": "#/$defs/limitation"}}
  },
  "$defs": {
    "path": {"type": "string", "minLength": 1, "maxLength": 4096, "pattern": "^(?!/)(?![A-Za-z]:)(?!.*\\\\)(?!.*(?:^|/)\\.\\.?(?:/|$))(?!.*//)(?!.*[\\u0000-\\u001f\\u007f]).+(?<!/)$"},
    "selector": {"anyOf": [{"$ref": "#/$defs/path"}, {"const": "."}]},
    "sha": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "request": {
      "type": "object", "additionalProperties": false,
      "required": ["kind", "repository_root", "base_revision", "head_revision", "working_tree_mode", "requested_paths", "context_paths"],
      "properties": {
        "kind": {"enum": ["ref_range", "working_tree", "paths"]},
        "repository_root": {"type": "string", "minLength": 1, "maxLength": 8192},
        "base_revision": {"type": ["string", "null"], "pattern": "^[0-9a-f]{40,64}$"},
        "head_revision": {"type": ["string", "null"], "pattern": "^[0-9a-f]{40,64}$"},
        "working_tree_mode": {"enum": ["combined", null]},
        "requested_paths": {"type": "array", "maxItems": 5000, "uniqueItems": true, "items": {"$ref": "#/$defs/selector"}},
        "context_paths": {"type": "array", "maxItems": 1000, "uniqueItems": true, "items": {"$ref": "#/$defs/path"}}
      }
    },
    "target": {
      "type": "object", "additionalProperties": false,
      "required": ["paths", "changes"],
      "properties": {
        "paths": {"type": "array", "maxItems": 5000, "uniqueItems": true, "items": {"$ref": "#/$defs/path"}},
        "changes": {"type": "array", "maxItems": 5000, "items": {"$ref": "#/$defs/change"}}
      }
    },
    "change": {
      "type": "object", "additionalProperties": false,
      "required": ["path", "source_path", "status"],
      "properties": {
        "path": {"$ref": "#/$defs/path"},
        "source_path": {"anyOf": [{"$ref": "#/$defs/path"}, {"type": "null"}]},
        "status": {"enum": ["added", "deleted", "modified", "renamed", "copied", "type_changed", "unmerged", "untracked", "snapshot", "unknown"]}
      }
    },
    "file": {
      "type": "object", "additionalProperties": false,
      "required": ["path", "role", "revision", "state", "size", "sha256", "line_count", "content"],
      "properties": {
        "path": {"$ref": "#/$defs/path"},
        "role": {"enum": ["target_before", "target_after", "context"]},
        "revision": {"type": ["string", "null"], "pattern": "^[0-9a-f]{40,64}$"},
        "state": {"enum": ["text", "binary", "oversized", "unreadable", "absent"]},
        "size": {"type": ["integer", "null"], "minimum": 0, "maximum": 4194304},
        "sha256": {"anyOf": [{"$ref": "#/$defs/sha"}, {"type": "null"}]},
        "line_count": {"type": ["integer", "null"], "minimum": 0, "maximum": 5000000},
        "content": {"type": ["string", "null"], "maxLength": 4194304}
      }
    },
    "guidance": {
      "type": "object", "additionalProperties": false,
      "required": ["kind", "path", "revision", "applies_to", "size", "sha256", "content"],
      "properties": {
        "kind": {"enum": ["review", "verification"]},
        "path": {"$ref": "#/$defs/path"},
        "revision": {"type": ["string", "null"], "pattern": "^[0-9a-f]{40,64}$"},
        "applies_to": {"type": "array", "minItems": 1, "maxItems": 5000, "uniqueItems": true, "items": {"$ref": "#/$defs/path"}},
        "size": {"type": "integer", "minimum": 0, "maximum": 1048576},
        "sha256": {"$ref": "#/$defs/sha"},
        "content": {"type": "string", "maxLength": 1048576}
      }
    },
    "limits": {
      "type": "object", "additionalProperties": false,
      "required": ["max_targets", "max_context_files", "max_file_bytes", "max_total_bytes", "max_guidance_bytes", "max_traversal_entries"],
      "properties": {
        "max_targets": {"type": "integer", "minimum": 1, "maximum": 5000},
        "max_context_files": {"type": "integer", "minimum": 0, "maximum": 1000},
        "max_file_bytes": {"type": "integer", "minimum": 1, "maximum": 4194304},
        "max_total_bytes": {"type": "integer", "minimum": 1, "maximum": 12582912},
        "max_guidance_bytes": {"type": "integer", "minimum": 1, "maximum": 1048576},
        "max_traversal_entries": {"type": "integer", "minimum": 1, "maximum": 250000}
      }
    },
    "limitation": {
      "type": "object", "additionalProperties": false,
      "required": ["code", "message", "paths", "material"],
      "properties": {
        "code": {"enum": ["empty_target", "scope_limit", "traversal_limit", "unsafe_path", "file_unreadable", "file_non_text", "file_oversized", "guidance_unavailable", "context_unavailable", "target_drift", "other"]},
        "message": {"type": "string", "minLength": 1, "maxLength": 4096},
        "paths": {"type": "array", "maxItems": 5000, "uniqueItems": true, "items": {"$ref": "#/$defs/path"}},
        "material": {"type": "boolean"}
      }
    }
  }
}
