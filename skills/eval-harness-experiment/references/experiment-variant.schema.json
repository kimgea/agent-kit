{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-kit.invalid/schemas/eval-harness-variant-v1.json",
  "title": "Eval harness variant v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "candidate_id", "base_revision", "base_repository_sha256", "editable_surfaces", "rationale", "edits"],
  "properties": {
    "schema_version": {"const": "eval-harness-variant/v1"},
    "candidate_id": {"$ref": "#/$defs/id"},
    "base_revision": {"type": "string", "pattern": "^[0-9a-f]{40}([0-9a-f]{24})?$"},
    "base_repository_sha256": {"$ref": "#/$defs/sha"},
    "editable_surfaces": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "sha256", "mode"],
        "properties": {
          "path": {"$ref": "#/$defs/path"},
          "sha256": {"$ref": "#/$defs/sha"},
          "mode": {"enum": ["100644", "100755"]}
        }
      }
    },
    "rationale": {"type": "string", "minLength": 1, "maxLength": 2000},
    "edits": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "before_sha256", "after_text"],
        "properties": {
          "path": {"$ref": "#/$defs/path"},
          "before_sha256": {"$ref": "#/$defs/sha"},
          "after_text": {"type": "string", "maxLength": 1048576}
        }
      }
    }
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[a-z][a-z0-9._-]{0,63}$"},
    "sha": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "path": {"type": "string", "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.?(?:/|$))(?!.*\\\\)(?!.*//)[^\\u0000-\\u001f\\u007f/](?:[^\\u0000-\\u001f\\u007f]*[^\\u0000-\\u001f\\u007f/])?$"}
  }
}
