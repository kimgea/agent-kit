{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/kimgea/agent-kit/schemas/review-guidance-audit/v1.json",
  "title": "Review guidance audit result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "context_sha256",
    "status",
    "target",
    "guidance",
    "context_metrics",
    "summary",
    "coverage",
    "recommendations",
    "limitations"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "context_sha256": {"$ref": "#/$defs/sha256"},
    "status": {"enum": ["COMPLETE", "INCOMPLETE"]},
    "target": {"$ref": "#/$defs/target"},
    "guidance": {
      "type": "array",
      "maxItems": 100000,
      "items": {"$ref": "#/$defs/guidance_chain"}
    },
    "context_metrics": {"$ref": "#/$defs/context_metrics"},
    "summary": {"$ref": "#/$defs/summary"},
    "coverage": {"$ref": "#/$defs/coverage"},
    "recommendations": {
      "type": "array",
      "maxItems": 2000,
      "items": {"$ref": "#/$defs/recommendation"}
    },
    "limitations": {
      "type": "array",
      "maxItems": 2000,
      "items": {"$ref": "#/$defs/limitation"}
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "repository_path": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096,
      "pattern": "^(?!/)(?![A-Za-z]:)(?!.*\\\\)(?!.*//)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*[\\u0000-\\u001f\\u007f]).+(?<!/)$"
    },
    "nullable_line": {
      "type": ["integer", "null"],
      "minimum": 1,
      "maximum": 100000000
    },
    "location": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "start_line", "end_line"],
      "properties": {
        "path": {"$ref": "#/$defs/repository_path"},
        "start_line": {"$ref": "#/$defs/nullable_line"},
        "end_line": {"$ref": "#/$defs/nullable_line"}
      }
    },
    "requested_target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["target_id", "kind", "path", "start_line", "end_line"],
      "properties": {
        "target_id": {"type": "string", "pattern": "^T[0-9]{3,6}$"},
        "kind": {"enum": ["part", "file", "directory", "project"]},
        "path": {
          "anyOf": [
            {"const": "."},
            {"$ref": "#/$defs/repository_path"}
          ]
        },
        "start_line": {"$ref": "#/$defs/nullable_line"},
        "end_line": {"$ref": "#/$defs/nullable_line"}
      }
    },
    "target_file": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "bytes", "sha256", "inspection_kind"],
      "properties": {
        "path": {"$ref": "#/$defs/repository_path"},
        "bytes": {"type": "integer", "minimum": 0},
        "sha256": {
          "anyOf": [
            {"$ref": "#/$defs/sha256"},
            {"type": "null"}
          ]
        },
        "inspection_kind": {
          "enum": ["text", "binary", "non_utf8", "oversized", "unreadable"]
        }
      }
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "repository_root", "requested", "files"],
      "properties": {
        "kind": {"const": "current_filesystem"},
        "repository_root": {"type": "string", "minLength": 1, "maxLength": 8192},
        "requested": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1000,
          "items": {"$ref": "#/$defs/requested_target"}
        },
        "files": {
          "type": "array",
          "maxItems": 100000,
          "items": {"$ref": "#/$defs/target_file"}
        }
      }
    },
    "guidance_source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_kind", "path", "revision", "sha256", "bytes", "words", "lines", "loaded"],
      "properties": {
        "source_kind": {"enum": ["skill", "user_global", "repository"]},
        "path": {"type": "string", "minLength": 1, "maxLength": 8192},
        "revision": {"type": ["string", "null"], "maxLength": 256},
        "sha256": {"$ref": "#/$defs/sha256"},
        "bytes": {"type": "integer", "minimum": 0},
        "words": {"type": "integer", "minimum": 0},
        "lines": {"type": "integer", "minimum": 0},
        "loaded": {"type": "boolean"}
      }
    },
    "guidance_chain": {
      "type": "object",
      "additionalProperties": false,
      "required": ["chain_id", "applies_to", "sources", "effective_bytes", "effective_words", "complete"],
      "properties": {
        "chain_id": {"type": "string", "pattern": "^G[0-9]{3,6}$"},
        "applies_to": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/repository_path"}
        },
        "sources": {
          "type": "array",
          "items": {"$ref": "#/$defs/guidance_source"}
        },
        "effective_bytes": {"type": "integer", "minimum": 0},
        "effective_words": {"type": "integer", "minimum": 0},
        "complete": {"type": "boolean"}
      }
    },
    "source_metric": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_kind", "path", "sha256", "bytes", "words", "lines", "fanout"],
      "properties": {
        "source_kind": {"enum": ["skill", "user_global", "repository"]},
        "path": {"type": "string", "minLength": 1, "maxLength": 8192},
        "sha256": {"$ref": "#/$defs/sha256"},
        "bytes": {"type": "integer", "minimum": 0},
        "words": {"type": "integer", "minimum": 0},
        "lines": {"type": "integer", "minimum": 0},
        "fanout": {"type": "integer", "minimum": 0}
      }
    },
    "context_metrics": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_count", "chain_count", "maximum_effective_words", "median_effective_words", "per_source"],
      "properties": {
        "source_count": {"type": "integer", "minimum": 0},
        "chain_count": {"type": "integer", "minimum": 0},
        "maximum_effective_words": {"type": "integer", "minimum": 0},
        "median_effective_words": {"type": "integer", "minimum": 0},
        "per_source": {
          "type": "array",
          "items": {"$ref": "#/$defs/source_metric"}
        }
      }
    },
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["keep", "rewrite", "move", "merge", "remove", "create"],
      "properties": {
        "keep": {"type": "integer", "minimum": 0},
        "rewrite": {"type": "integer", "minimum": 0},
        "move": {"type": "integer", "minimum": 0},
        "merge": {"type": "integer", "minimum": 0},
        "remove": {"type": "integer", "minimum": 0},
        "create": {"type": "integer", "minimum": 0}
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["conclusion", "recommendation_counts", "ready", "decision_required", "harness_changes"],
      "properties": {
        "conclusion": {"type": "string", "minLength": 1, "maxLength": 3000},
        "recommendation_counts": {"$ref": "#/$defs/counts"},
        "ready": {"type": "integer", "minimum": 0},
        "decision_required": {"type": "integer", "minimum": 0},
        "harness_changes": {"type": "integer", "minimum": 0}
      }
    },
    "excluded": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "reason", "material"],
      "properties": {
        "path": {"$ref": "#/$defs/repository_path"},
        "reason": {"type": "string", "minLength": 1, "maxLength": 2000},
        "material": {"type": "boolean"}
      }
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["complete", "inspected_paths", "excluded", "context_paths"],
      "properties": {
        "complete": {"type": "boolean"},
        "inspected_paths": {
          "type": "array",
          "items": {"$ref": "#/$defs/repository_path"}
        },
        "excluded": {
          "type": "array",
          "items": {"$ref": "#/$defs/excluded"}
        },
        "context_paths": {
          "type": "array",
          "items": {"$ref": "#/$defs/repository_path"}
        }
      }
    },
    "guidance_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_kind", "path", "sha256", "start_line", "end_line"],
      "properties": {
        "source_kind": {"enum": ["user_global", "repository"]},
        "path": {"type": "string", "minLength": 1, "maxLength": 8192},
        "sha256": {"$ref": "#/$defs/sha256"},
        "start_line": {"$ref": "#/$defs/nullable_line"},
        "end_line": {"$ref": "#/$defs/nullable_line"}
      }
    },
    "destination": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_kind", "path"],
      "properties": {
        "source_kind": {"enum": ["user_global", "repository"]},
        "path": {"type": "string", "minLength": 1, "maxLength": 8192}
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "description", "location"],
      "properties": {
        "kind": {"enum": ["guidance", "code", "test", "specification", "documentation", "configuration", "history", "reasoning"]},
        "description": {"type": "string", "minLength": 1, "maxLength": 4000},
        "location": {
          "anyOf": [
            {"$ref": "#/$defs/location"},
            {"type": "null"}
          ]
        }
      }
    },
    "savings": {
      "type": "object",
      "additionalProperties": false,
      "required": ["words", "bytes", "basis"],
      "properties": {
        "words": {"type": ["integer", "null"], "minimum": 0},
        "bytes": {"type": ["integer", "null"], "minimum": 0},
        "basis": {"type": "string", "minLength": 1, "maxLength": 2000}
      }
    },
    "harness_change": {
      "type": "object",
      "additionalProperties": false,
      "required": ["relationship", "kind", "summary", "reason", "coverage", "timing", "speed", "enforcement", "determinism", "availability", "diagnostics", "paths"],
      "properties": {
        "relationship": {"enum": ["replace", "partially_cover", "support"]},
        "kind": {"enum": ["test", "lint", "formatter", "schema", "static_analysis", "validator", "other"]},
        "summary": {"type": "string", "minLength": 1, "maxLength": 1000},
        "reason": {"type": "string", "minLength": 1, "maxLength": 4000},
        "coverage": {"enum": ["complete", "partial", "unknown"]},
        "timing": {"enum": ["review_loop", "pre_merge", "pre_deploy", "manual", "unknown"]},
        "speed": {"enum": ["fast", "slow", "unknown"]},
        "enforcement": {"enum": ["required", "optional", "unknown"]},
        "determinism": {"enum": ["deterministic", "nondeterministic", "unknown"]},
        "availability": {"enum": ["ordinary", "restricted", "unknown"]},
        "diagnostics": {"enum": ["actionable", "weak", "unknown"]},
        "paths": {
          "type": "array",
          "items": {"$ref": "#/$defs/repository_path"}
        }
      }
    },
    "recommendation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "recommendation_id",
        "fingerprint",
        "action",
        "strength",
        "decision",
        "intent_effect",
        "title",
        "reason",
        "current_guidance",
        "destination",
        "affected_targets",
        "affected_paths",
        "evidence",
        "estimated_savings",
        "proposed_text",
        "harness_changes"
      ],
      "properties": {
        "recommendation_id": {"type": "string", "pattern": "^R[0-9]{3,6}$"},
        "fingerprint": {"$ref": "#/$defs/sha256"},
        "action": {"enum": ["keep", "rewrite", "move", "merge", "remove", "create"]},
        "strength": {"enum": ["essential", "strong", "moderate", "optional"]},
        "decision": {"enum": ["ready", "decision_required"]},
        "intent_effect": {"enum": ["preserved", "narrowed", "changed"]},
        "title": {"type": "string", "minLength": 1, "maxLength": 300},
        "reason": {"type": "string", "minLength": 1, "maxLength": 6000},
        "current_guidance": {
          "type": "array",
          "maxItems": 64,
          "items": {"$ref": "#/$defs/guidance_ref"}
        },
        "destination": {
          "anyOf": [
            {"$ref": "#/$defs/destination"},
            {"type": "null"}
          ]
        },
        "affected_targets": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "pattern": "^T[0-9]{3,6}$"}
        },
        "affected_paths": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/repository_path"}
        },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "items": {"$ref": "#/$defs/evidence"}
        },
        "estimated_savings": {"$ref": "#/$defs/savings"},
        "proposed_text": {"type": ["string", "null"], "minLength": 1, "maxLength": 16000},
        "harness_changes": {
          "type": "array",
          "maxItems": 32,
          "items": {"$ref": "#/$defs/harness_change"}
        }
      }
    },
    "limitation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "message", "affected_paths", "material"],
      "properties": {
        "code": {"enum": ["scope_truncated", "target_unreadable", "part_unreadable", "guidance_unreadable", "guidance_budget", "coverage_incomplete", "context_unavailable", "evidence_missing", "conflicting_evidence", "other"]},
        "message": {"type": "string", "minLength": 1, "maxLength": 4000},
        "affected_paths": {
          "type": "array",
          "items": {"$ref": "#/$defs/repository_path"}
        },
        "material": {"type": "boolean"}
      }
    }
  }
}
