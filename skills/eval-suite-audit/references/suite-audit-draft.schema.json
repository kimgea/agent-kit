{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-kit.invalid/schemas/suite-audit-draft-v1.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["completion", "recommendations", "limitations"],
  "properties": {
    "completion": {"enum": ["complete", "incomplete"]},
    "recommendations": {"type": "array", "maxItems": 2000, "items": {"$ref": "#/$defs/recommendation"}},
    "limitations": {"type": "array", "maxItems": 2000, "items": {"$ref": "#/$defs/limitation"}}
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[a-z][a-z0-9._-]{0,63}$"},
    "limitation": {"type": "object", "additionalProperties": false, "required": ["code", "message", "material"], "properties": {"code": {"$ref": "#/$defs/id"}, "message": {"type": "string", "minLength": 1, "maxLength": 2000}, "material": {"type": "boolean"}}},
    "replacement": {"type": "object", "additionalProperties": false, "required": ["status", "case_ids", "explanation"], "properties": {"status": {"enum": ["none", "partial", "complete", "unknown"]}, "case_ids": {"type": "array", "maxItems": 256, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}}, "explanation": {"type": "string", "minLength": 1, "maxLength": 2000}}},
    "recommendation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["case_ids", "action", "strength", "reason", "confidence", "evidence_ids", "basis", "unique_coverage", "replacement_coverage", "coverage_effect", "cost_effect", "limitations"],
      "properties": {
        "case_ids": {"type": "array", "minItems": 1, "maxItems": 256, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}},
        "action": {"enum": ["keep", "refresh", "merge", "simplify", "demote", "retire"]},
        "strength": {"enum": ["strong", "moderate", "optional"]},
        "reason": {"type": "string", "minLength": 1, "maxLength": 2000},
        "confidence": {"enum": ["high", "medium", "low", "unknown"]},
        "evidence_ids": {"type": "array", "minItems": 1, "maxItems": 256, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}},
        "basis": {"enum": ["removed_behavior", "duplicate_coverage", "superseded_coverage", "obsolete_fixture", "obsolete_architecture", "no_unique_agent_value", "cost_without_unique_coverage", "healthy_unique_coverage", "stale_but_relevant", "compaction", "other"]},
        "unique_coverage": {"type": "string", "minLength": 1, "maxLength": 2000},
        "replacement_coverage": {"$ref": "#/$defs/replacement"},
        "coverage_effect": {"enum": ["preserved", "loss", "changed", "unknown"]},
        "cost_effect": {"enum": ["decrease", "none", "increase", "unknown"]},
        "limitations": {"type": "array", "maxItems": 64, "items": {"$ref": "#/$defs/limitation"}}
      }
    }
  }
}
