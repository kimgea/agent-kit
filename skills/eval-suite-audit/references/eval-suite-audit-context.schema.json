{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-kit.invalid/schemas/eval-suite-audit-context-v1.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "repository_root", "repository_head", "repository_sha256", "suite", "cases", "profiles", "evidence_sources", "evidence", "limits", "limitations", "context_sha256"],
  "properties": {
    "schema_version": {"const": "eval-suite-audit-context/v1"},
    "repository_root": {"type": "string", "minLength": 1, "maxLength": 4096},
    "repository_head": {"type": "string", "pattern": "^[0-9a-f]{40,64}$"},
    "repository_sha256": {"$ref": "#/$defs/sha"},
    "suite": {"type": "object", "additionalProperties": false, "required": ["path", "source_sha256", "suite_digest", "suite_id", "title"], "properties": {"path": {"type": "string", "minLength": 1, "maxLength": 4096}, "source_sha256": {"$ref": "#/$defs/sha"}, "suite_digest": {"$ref": "#/$defs/sha"}, "suite_id": {"$ref": "#/$defs/id"}, "title": {"type": "string", "minLength": 1, "maxLength": 200}}},
    "cases": {"type": "array", "minItems": 1, "maxItems": 500, "items": {"$ref": "#/$defs/case"}},
    "profiles": {"type": "array", "minItems": 1, "maxItems": 32, "items": {"$ref": "#/$defs/profile"}},
    "evidence_sources": {"type": "array", "maxItems": 32, "items": {"$ref": "#/$defs/source"}},
    "evidence": {"type": "array", "maxItems": 4096, "items": {"$ref": "#/$defs/context_evidence"}},
    "limits": {"type": "object", "additionalProperties": false, "required": ["max_input_bytes", "max_evidence_sources", "max_evidence", "max_summary_bytes", "max_fixture_entries", "max_fixture_files", "max_fixture_bytes"], "properties": {"max_input_bytes": {"const": 2097152}, "max_evidence_sources": {"const": 32}, "max_evidence": {"const": 4096}, "max_summary_bytes": {"const": 1048576}, "max_fixture_entries": {"const": 40000}, "max_fixture_files": {"const": 20000}, "max_fixture_bytes": {"const": 67108864}}},
    "limitations": {"type": "array", "maxItems": 2000, "items": {"$ref": "#/$defs/limitation"}},
    "context_sha256": {"$ref": "#/$defs/sha"}
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[a-z][a-z0-9._-]{0,63}$"},
    "sha": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "case": {"type": "object", "additionalProperties": false, "required": ["case_id", "title", "kind", "importance", "fixture", "fixture_sha256", "fixture_files", "fixture_bytes", "task", "coverage", "platforms", "assertion_ids", "profiles"], "properties": {"case_id": {"$ref": "#/$defs/id"}, "title": {"type": "string", "minLength": 1, "maxLength": 200}, "kind": {"enum": ["explanation", "implementation", "trajectory"]}, "importance": {"enum": ["required", "important", "standard", "exploratory"]}, "fixture": {"type": "string", "minLength": 1, "maxLength": 4096}, "fixture_sha256": {"$ref": "#/$defs/sha"}, "fixture_files": {"type": "integer", "minimum": 1, "maximum": 20000}, "fixture_bytes": {"type": "integer", "minimum": 0, "maximum": 67108864}, "task": {"type": "string", "minLength": 1, "maxLength": 4000}, "coverage": {"enum": ["development", "holdout", "regression"]}, "platforms": {"type": "array", "minItems": 1, "maxItems": 3, "uniqueItems": true, "items": {"enum": ["linux", "windows", "macos"]}}, "assertion_ids": {"type": "array", "minItems": 1, "maxItems": 256, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}}, "profiles": {"type": "array", "maxItems": 32, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}}}},
    "profile": {"type": "object", "additionalProperties": false, "required": ["profile_id", "case_ids", "repetitions", "max_invocations", "max_seconds", "max_tokens", "max_cost_usd"], "properties": {"profile_id": {"$ref": "#/$defs/id"}, "case_ids": {"type": "array", "minItems": 1, "maxItems": 500, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}}, "repetitions": {"type": "integer", "minimum": 1, "maximum": 100}, "max_invocations": {"type": "integer", "minimum": 1, "maximum": 10000}, "max_seconds": {"type": "integer", "minimum": 1, "maximum": 86400}, "max_tokens": {"type": ["integer", "null"], "minimum": 1, "maximum": 1000000000}, "max_cost_usd": {"type": ["number", "null"], "minimum": 0, "maximum": 1000000}}},
    "source": {"type": "object", "additionalProperties": false, "required": ["source_id", "path", "sha256", "schema_version", "authority"], "properties": {"source_id": {"$ref": "#/$defs/id"}, "path": {"type": "string", "minLength": 1, "maxLength": 4096}, "sha256": {"$ref": "#/$defs/sha"}, "schema_version": {"enum": ["project-eval-run-result/v1", "eval-candidate-result/v1"]}, "authority": {"const": "evidence_only"}}},
    "evidence": {"type": "object", "additionalProperties": false, "required": ["evidence_id", "kind", "sha256", "summary", "redacted"], "properties": {"evidence_id": {"$ref": "#/$defs/id"}, "kind": {"enum": ["session_summary", "run_receipt", "assertion", "measurement", "repository"]}, "sha256": {"$ref": "#/$defs/sha"}, "summary": {"type": "string", "minLength": 1, "maxLength": 500}, "redacted": {"const": true}}},
    "context_evidence": {"type": "object", "additionalProperties": false, "required": ["evidence_id", "kind", "sha256", "summary", "redacted", "case_ids"], "properties": {"evidence_id": {"$ref": "#/$defs/id"}, "kind": {"enum": ["session_summary", "run_receipt", "assertion", "measurement", "repository"]}, "sha256": {"$ref": "#/$defs/sha"}, "summary": {"type": "string", "minLength": 1, "maxLength": 500}, "redacted": {"const": true}, "case_ids": {"type": "array", "minItems": 1, "maxItems": 256, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}}}},
    "limitation": {"type": "object", "additionalProperties": false, "required": ["code", "message", "material"], "properties": {"code": {"$ref": "#/$defs/id"}, "message": {"type": "string", "minLength": 1, "maxLength": 2000}, "material": {"type": "boolean"}}
  }
}
