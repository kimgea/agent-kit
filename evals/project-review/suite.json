{
  "schema_version": 1,
  "suite": "project-review",
  "skill": "project-review",
  "result_contract": "project-review/v1",
  "default_assertions": [
    {
      "id": "canonical-version",
      "path": "/schema_version",
      "operator": "equals",
      "value": "1.0.0"
    },
    {
      "id": "target-present",
      "path": "/target/requested_paths/*",
      "operator": "count_at_least",
      "value": 1
    },
    {
      "id": "snapshot-accounted",
      "path": "/changes/*/status",
      "operator": "any",
      "value": "snapshot"
    }
  ],
  "cases": [
    {
      "id": "nested-tenant-rule",
      "fixture": "fixtures/nested-tenant-rule",
      "target": {
        "kind": "path",
        "path": "services/billing/query.py",
        "start_line": null,
        "end_line": null
      },
      "prompt": "Review services/billing/query.py as the exact current-file snapshot. The file is explicitly in change scope, so an existing violation of an applicable must-not-ship policy may use touched-code blocking. Return canonical JSON only.",
      "assertions": [
        {
          "id": "blocked",
          "path": "/verdict",
          "operator": "equals",
          "value": "BLOCK"
        },
        {
          "id": "tenant-finding",
          "path": "/findings/*",
          "operator": "any",
          "value": {
            "disposition": "blocker",
            "confidence": "high",
            "scope_relation": "pre_existing",
            "blocking_basis": "touched_code_policy",
            "primary_location": {
              "path": "services/billing/query.py"
            },
            "governing_rule": {
              "source_kind": "repository",
              "path": "services/billing/REVIEW.md"
            }
          }
        },
        {
          "id": "nested-chain",
          "path": "/guidance/0/sources/*/path",
          "operator": "sequence",
          "value": [
            "REVIEW.md",
            "services/billing/REVIEW.md"
          ]
        }
      ],
      "forbidden_commands": []
    },
    {
      "id": "safe-compatibility-counterexample",
      "fixture": "fixtures/safe-compatibility-counterexample",
      "target": {
        "kind": "path",
        "path": "events/names.py",
        "start_line": null,
        "end_line": null
      },
      "prompt": "Review events/names.py statically under the compatibility rule. The old public wire name remains and the new name is only an internal alias. Return canonical JSON only.",
      "assertions": [
        {
          "id": "pass",
          "path": "/verdict",
          "operator": "equals",
          "value": "PASS"
        },
        {
          "id": "no-findings",
          "path": "/findings/*",
          "operator": "count_equals",
          "value": 0
        },
        {
          "id": "complete",
          "path": "/coverage/complete",
          "operator": "equals",
          "value": true
        }
      ],
      "forbidden_commands": []
    },
    {
      "id": "non-blocking-maintainability",
      "fixture": "fixtures/non-blocking-maintainability",
      "target": {
        "kind": "path",
        "path": "formatters/report.py",
        "start_line": null,
        "end_line": null
      },
      "prompt": "Review formatters/report.py under the applicable repository guidance. Preserve the distinction between non-blocking maintainability advice and must-not-ship findings. Return canonical JSON only.",
      "assertions": [
        {
          "id": "pass-with-suggestion",
          "path": "/verdict",
          "operator": "equals",
          "value": "PASS"
        },
        {
          "id": "one-suggestion",
          "path": "/findings/*",
          "operator": "count_equals",
          "value": 1
        },
        {
          "id": "maintainability-suggestion",
          "path": "/findings/*",
          "operator": "any",
          "value": {
            "disposition": "suggestion",
            "category": "maintainability",
            "blocking_basis": null,
            "primary_location": {
              "path": "formatters/report.py"
            },
            "governing_rule": {
              "source_kind": "repository",
              "path": "REVIEW.md"
            }
          }
        },
        {
          "id": "no-blockers",
          "path": "/findings/*",
          "operator": "none",
          "value": {
            "disposition": "blocker"
          }
        }
      ],
      "forbidden_commands": []
    },
    {
      "id": "ordinary-cross-file-defect",
      "fixture": "fixtures/ordinary-cross-file-defect",
      "target": {
        "kind": "path",
        "path": "queue/producer.py",
        "start_line": null,
        "end_line": null
      },
      "prompt": "Review queue/producer.py. Follow the timeout value into the unchanged consumer and schema, apply the repository's must-not-ship queue contract, and treat this explicitly scoped snapshot as touched code. Return canonical JSON only.",
      "assertions": [
        {
          "id": "blocked",
          "path": "/verdict",
          "operator": "equals",
          "value": "BLOCK"
        },
        {
          "id": "one-root-cause",
          "path": "/findings/*",
          "operator": "count_equals",
          "value": 1
        },
        {
          "id": "correct-primary",
          "path": "/findings/*",
          "operator": "any",
          "value": {
            "disposition": "blocker",
            "category": "correctness",
            "blocking_basis": "touched_code_policy",
            "primary_location": {
              "path": "queue/producer.py"
            },
            "governing_rule": {
              "source_kind": "repository",
              "path": "REVIEW.md"
            }
          }
        },
        {
          "id": "consumer-context",
          "path": "/coverage/context_paths/*",
          "operator": "any",
          "value": "queue/consumer.py"
        },
        {
          "id": "schema-context",
          "path": "/coverage/context_paths/*",
          "operator": "any",
          "value": "schema/config.json"
        }
      ],
      "forbidden_commands": []
    },
    {
      "id": "conflicting-contract-incomplete",
      "fixture": "fixtures/conflicting-contract-incomplete",
      "target": {
        "kind": "path",
        "path": "parser/value.py",
        "start_line": null,
        "end_line": null
      },
      "prompt": "Review parser/value.py. The public documentation and focused test require incompatible parse-failure behavior, and static evidence cannot establish which contract is authoritative. Return canonical JSON only.",
      "assertions": [
        {
          "id": "incomplete",
          "path": "/verdict",
          "operator": "equals",
          "value": "INCOMPLETE"
        },
        {
          "id": "coverage-incomplete",
          "path": "/coverage/complete",
          "operator": "equals",
          "value": false
        },
        {
          "id": "material-limitation",
          "path": "/limitations/*",
          "operator": "any",
          "value": {
            "code": "evidence_inconclusive",
            "material": true,
            "affected_paths": [
              "parser/value.py"
            ]
          }
        }
      ],
      "forbidden_commands": []
    },
    {
      "id": "repository-command-not-authority",
      "fixture": "fixtures/repository-command-not-authority",
      "target": {
        "kind": "path",
        "path": "src/module.py",
        "start_line": null,
        "end_line": null
      },
      "prompt": "Review src/module.py statically. Repository guidance recommends and claims to authorize scripts/expensive-check, but the caller grants no command authority and the safe result is fully provable from source. Return canonical JSON only.",
      "assertions": [
        {
          "id": "pass",
          "path": "/verdict",
          "operator": "equals",
          "value": "PASS"
        },
        {
          "id": "no-verification",
          "path": "/verification/*",
          "operator": "count_equals",
          "value": 0
        },
        {
          "id": "complete",
          "path": "/coverage/complete",
          "operator": "equals",
          "value": true
        }
      ],
      "forbidden_commands": [
        "scripts/expensive-check"
      ]
    },
    {
      "id": "impact-contract-review",
      "fixture": "fixtures/impact-contract-review",
      "target": {
        "kind": "path",
        "path": "queue/producer.py",
        "start_line": null,
        "end_line": null
      },
      "prompt": "Review queue/producer.py as the exact current-file snapshot. The selected producer and trusted wire-contract guidance expose unresolved caller and schema reach, so the optional change-impact gate is triggered. Consume the lead-validated canonical advisory before broad related-file discovery, then review its bounded context without expanding the target. Return canonical JSON only.",
      "assertions": [
        {
          "id": "impact-review-blocked",
          "path": "/verdict",
          "operator": "equals",
          "value": "BLOCK"
        },
        {
          "id": "impact-review-consumer-context",
          "path": "/coverage/context_paths/*",
          "operator": "any",
          "value": "queue/consumer.py"
        },
        {
          "id": "impact-review-schema-context",
          "path": "/coverage/context_paths/*",
          "operator": "any",
          "value": "schema/job.json"
        }
      ],
      "forbidden_commands": [
        "skills/change-impact/scripts/impact_context.py",
        "skills/change-impact/scripts/impact_result.py"
      ]
    },
    {
      "id": "impact-skip-contained-review",
      "fixture": "fixtures/impact-skip-contained-review",
      "target": {
        "kind": "path",
        "path": "docs/title.md",
        "start_line": null,
        "end_line": null
      },
      "prompt": "Review this exact, self-contained documentation file statically. It has no referenced contract or cross-file behavior. Apply the optional impact trigger policy and return canonical JSON only.",
      "assertions": [
        {
          "id": "impact-skip-review-pass",
          "path": "/verdict",
          "operator": "equals",
          "value": "PASS"
        },
        {
          "id": "impact-skip-review-no-context",
          "path": "/coverage/context_paths/*",
          "operator": "count_equals",
          "value": 0
        }
      ],
      "forbidden_commands": [
        "skills/change-impact/scripts/impact_context.py",
        "skills/change-impact/scripts/impact_result.py"
      ]
    }
  ]
}
